#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="warp-vps-manager"
APP_DIR="/opt/${APP_NAME}"
ETC_DIR="/etc/${APP_NAME}"
STATE_DIR="/var/lib/${APP_NAME}"
SELF_PATH="${BASH_SOURCE[0]:-$0}"
CONFIG_FILE="${WARP_VPS_CONFIG_FILE:-${ETC_DIR}/config.env}"
REDSOCKS_CONF="${ETC_DIR}/redsocks.conf"
NFT_CONF="${ETC_DIR}/nftables.conf"
RULES_DIR="${WARP_VPS_RULES_DIR:-${APP_DIR}/rules}"
BIN_PATH="/usr/local/bin/warp-vps"
DEFAULT_WG_IFACE="warp-vps-wg"
DEFAULT_WGCF_BIN="${APP_DIR}/bin/wgcf"
DEFAULT_WG_CONFIG="/etc/wireguard/${DEFAULT_WG_IFACE}.conf"
WG_GLOBAL_TABLE=51888
WG_GLOBAL_MARK=51888
WG_GLOBAL_MAIN_RULE_PRIORITY=18000
WG_GLOBAL_RULE_PRIORITY=18001
WG_GLOBAL_NFT_TABLE="warp_vps_global"
WG_GLOBAL_SRC_VALID_MARK_PATH="/proc/sys/net/ipv4/conf/all/src_valid_mark"
WGCF_ACCOUNT="${STATE_DIR}/wgcf/wgcf-account.toml"
DEFAULT_WGCF_VERSION="v2.2.32"
DEFAULT_REPO_RAW_BASE="https://raw.githubusercontent.com/mqfut123/warp-vps-manager/main"
RUNTIME_LOCK_FILE="/run/${APP_NAME}.operation.lock"
MANAGED_SWAP_FILE="/swapfile-warp-vps-manager"
REDSOCKS_FALLBACK_BIN="/usr/local/sbin/redsocks"
REDSOCKS_SOURCE_COMMIT="27b17889a43e32b0c1162514d00967e6967d41bb"
REDSOCKS_MANAGED_VERSION="redsocks/0.5-${REDSOCKS_SOURCE_COMMIT}"
UNLOCK_TEST_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"
UNLOCK_CONNECT_TIMEOUT=5
UNLOCK_MAX_TIME=12
DOWNLOAD_CONNECT_TIMEOUT=10
DOWNLOAD_MAX_TIME=120
WGCF_OPERATION_TIMEOUT=120
WARP_REGISTRATION_STATE="unknown"
WARP_REGISTRATION_DETAIL=""
WARP_RUNTIME_DETAILS=""
UNINSTALL_REMOVE_DEPENDENCIES=0
UNINSTALL_WG_CONFIG_EXPLICIT=0
UNINSTALL_WIREGUARD_PRESENT=0
UNINSTALL_RUNTIME_IDENTIFIED=0
HEALTH_MAINTENANCE_ARMED=0
HEALTH_TIMER_WAS_ACTIVE=0

if [ -t 1 ]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
else
  C_RESET=''
  C_BOLD=''
  C_RED=''
  C_GREEN=''
  C_YELLOW=''
  C_CYAN=''
fi

log() { printf '[warp-vps] %s\n' "$*"; }
warn() { printf '[warp-vps] 警告：%s\n' "$*" >&2; }
die() { printf '[warp-vps] 错误：%s\n' "$*" >&2; exit 1; }

read_input() {
  local var_name="$1"
  if [ -r /dev/tty ]; then
    # shellcheck disable=SC2229
    IFS= read -r "$var_name" </dev/tty
  else
    # shellcheck disable=SC2229
    IFS= read -r "$var_name"
  fi
}

section() {
  printf '\n%b%s%b\n' "$C_BOLD" "$1" "$C_RESET"
}

info_line() {
  printf '%b%s%b %s\n' "$C_CYAN" "[信息]" "$C_RESET" "$1"
}

ok_line() {
  printf '%b%s%b %s\n' "$C_GREEN" "[通过]" "$C_RESET" "$1"
}

fail_line() {
  printf '%b%s%b %s\n' "$C_RED" "[失败]" "$C_RESET" "$1"
}

warn_line() {
  printf '%b%s%b %s\n' "$C_YELLOW" "[注意]" "$C_RESET" "$1"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "请使用 root 用户运行"
}

run_with_runtime_lock() {
  local policy="$1" rc
  shift
  require_root

  if ! command -v flock >/dev/null 2>&1; then
    "$@"
    return
  fi

  if ! exec 9>"$RUNTIME_LOCK_FILE"; then
    if [ "$policy" = "skip" ]; then
      log "无法建立管理操作锁，本次健康检查跳过"
      return 0
    fi
    die "无法建立管理操作锁，未修改当前运行态"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi

  if [ "$policy" = "skip" ]; then
    if ! flock -n 9; then
      exec 9>&-
      log "另一项管理操作正在进行，本次健康检查跳过"
      return 0
    fi
  elif ! flock -w 10 9; then
    exec 9>&-
    die "另一项 WARP VPS Manager 管理操作正在进行，请稍后重试"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi

  "$@"
  rc=$?
  flock -u 9 >/dev/null 2>&1 || true
  exec 9>&-
  return "$rc"
}

load_config() {
  [ -r "$CONFIG_FILE" ] || die "找不到配置文件：$CONFIG_FILE"
  local line key value
  unset WARP_MODE WARP_SCOPE WARP_SOCKS_PORT REDSOCKS_PORT REDSOCKS_USER REDSOCKS_UID \
    REDSOCKS_GROUP REDSOCKS_BIN WG_IFACE WGCF_BIN WG_CONFIG \
    MANAGED_WARP_SVC MANAGED_REDSOCKS_BIN
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
      *=*) ;;
      *) die "配置文件格式错误：$CONFIG_FILE: $line" ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      APP_VERSION) : ;;
      REPO_RAW_BASE) : ;;
      WARP_MODE) WARP_MODE="$value" ;;
      WARP_SCOPE) WARP_SCOPE="$value" ;;
      WARP_SOCKS_PORT) WARP_SOCKS_PORT="$value" ;;
      REDSOCKS_PORT) REDSOCKS_PORT="$value" ;;
      REDSOCKS_USER) REDSOCKS_USER="$value" ;;
      REDSOCKS_UID) REDSOCKS_UID="$value" ;;
      REDSOCKS_GROUP) REDSOCKS_GROUP="$value" ;;
      REDSOCKS_BIN) REDSOCKS_BIN="$value" ;;
      WG_IFACE) WG_IFACE="$value" ;;
      WGCF_BIN) WGCF_BIN="$value" ;;
      WG_CONFIG) WG_CONFIG="$value" ;;
      MANAGED_WARP_SVC) MANAGED_WARP_SVC="$value" ;;
      MANAGED_REDSOCKS_BIN) MANAGED_REDSOCKS_BIN="$value" ;;
      *) die "配置文件存在未知字段：$key" ;;
    esac
  done < "$CONFIG_FILE"
  WARP_MODE="${WARP_MODE:-socks}"
  case "$WARP_MODE" in
    socks|wireguard) ;;
    *) die "配置里的 WARP_MODE 无效：$WARP_MODE" ;;
  esac
  WARP_SCOPE="${WARP_SCOPE:-google}"
  case "$WARP_SCOPE" in
    google|global) ;;
    *) die "配置里的 WARP_SCOPE 无效：$WARP_SCOPE" ;;
  esac
  WG_IFACE="${WG_IFACE:-$DEFAULT_WG_IFACE}"
  WGCF_BIN="${WGCF_BIN:-$DEFAULT_WGCF_BIN}"
  WG_CONFIG="${WG_CONFIG:-/etc/wireguard/${WG_IFACE}.conf}"
  [ -n "${WARP_SOCKS_PORT:-}" ] || WARP_SOCKS_PORT=0
  [ -n "${REDSOCKS_PORT:-}" ] || REDSOCKS_PORT=0
  [ -n "${REDSOCKS_USER:-}" ] || die "配置缺少 REDSOCKS_USER"
  [ -n "${REDSOCKS_UID:-}" ] || die "配置缺少 REDSOCKS_UID"
  REDSOCKS_GROUP="${REDSOCKS_GROUP:-$REDSOCKS_USER}"
  if [ -z "${MANAGED_WARP_SVC:-}" ]; then
    if [ "$WARP_MODE" = "socks" ]; then
      MANAGED_WARP_SVC=1
    else
      MANAGED_WARP_SVC=0
    fi
  fi
  if [ -z "${MANAGED_REDSOCKS_BIN:-}" ]; then
    MANAGED_REDSOCKS_BIN=0
    if managed_redsocks_fallback_exists; then
      MANAGED_REDSOCKS_BIN=1
    fi
  fi
  [ -n "${REDSOCKS_GROUP:-}" ] || die "配置缺少 REDSOCKS_GROUP"
  [ -n "${REDSOCKS_BIN:-}" ] || die "配置缺少 REDSOCKS_BIN"
  REPO_RAW_BASE="${WARP_VPS_REPO_BASE:-$DEFAULT_REPO_RAW_BASE}"
  if [ "$WARP_MODE" = "socks" ]; then
    valid_config_port "$WARP_SOCKS_PORT" || die "配置里的 WARP_SOCKS_PORT 不是有效端口"
    valid_config_port "$REDSOCKS_PORT" || die "配置里的 REDSOCKS_PORT 不是有效端口"
  fi
  case "$REDSOCKS_UID" in ''|*[!0-9]*) die "配置里的 REDSOCKS_UID 不是有效数字" ;; esac
  case "$MANAGED_WARP_SVC" in 0|1) ;; *) die "配置里的 MANAGED_WARP_SVC 不是有效值" ;; esac
  case "$MANAGED_REDSOCKS_BIN" in 0|1) ;; *) die "配置里的 MANAGED_REDSOCKS_BIN 不是有效值" ;; esac
  valid_config_name "$REDSOCKS_USER" || die "配置里的 REDSOCKS_USER 不是有效用户"
  valid_config_name "$REDSOCKS_GROUP" || die "配置里的 REDSOCKS_GROUP 不是有效用户组"
  valid_config_path "$REDSOCKS_BIN" || die "配置里的 REDSOCKS_BIN 不是安全绝对路径"
  valid_config_iface "$WG_IFACE" || die "配置里的 WG_IFACE 不是有效网卡名"
  valid_config_path "$WGCF_BIN" || die "配置里的 WGCF_BIN 不是安全绝对路径"
  valid_config_path "$WG_CONFIG" || die "配置里的 WG_CONFIG 不是安全绝对路径"
  validate_repo_raw_base "$REPO_RAW_BASE"
}

valid_config_port() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_config_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
    *) return 0 ;;
  esac
}

valid_config_iface() {
  case "$1" in
    ''|*[!A-Za-z0-9_.:-]*) return 1 ;;
    *) [ "${#1}" -le 15 ] ;;
  esac
}

valid_config_path() {
  case "$1" in
    /*)
      case "$1" in *$'\n'*|*$'\r'*|*$'\t'*|*" "*) return 1 ;; esac
      return 0
      ;;
    *) return 1 ;;
  esac
}

validate_repo_raw_base() {
  local url="$1"
  [ -n "$url" ] || die "REPO_RAW_BASE 不能为空"
  case "$url" in
    https://*) ;;
    *) die "REPO_RAW_BASE 必须以 https:// 开头" ;;
  esac
  case "$url" in
    *$'\n'*|*$'\r'*|*$'\t'*|*" "*) die "REPO_RAW_BASE 不能包含空格或换行" ;;
  esac
  local rest="${url#https://}"
  local authority="${rest%%/*}"
  case "$authority" in
    *@*) die "REPO_RAW_BASE 不能包含账号密码信息" ;;
    '') die "REPO_RAW_BASE 缺少域名" ;;
  esac
}

raw_asset_url() {
  local rel="$1"
  printf '%s/%s\n' "${REPO_RAW_BASE%/}" "$rel"
}

mask_repo_url() {
  local url="$1"
  local rest authority
  rest="${url#https://}"
  authority="${rest%%/*}"
  if [ "$rest" = "$authority" ]; then
    printf 'https://%s\n' "$authority"
  else
    printf 'https://%s/%s\n' "$authority" "${rest#*/}"
  fi
}

validate_rules_file() {
  local file="$1"
  local version="$2"
  python3 - "$file" "$version" <<'PY'
import ipaddress
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
version = int(sys.argv[2])
seen = 0
for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line != raw or any(ch.isspace() for ch in line):
        raise SystemExit(f"{path}:{lineno}: 存在非法空格")
    network = ipaddress.ip_network(line, strict=True)
    if network.version != version:
        raise SystemExit(f"{path}:{lineno}: 需要 IPv{version}，实际是 IPv{network.version}")
    seen += 1
if seen == 0:
    raise SystemExit(f"{path}: 规则为空")
PY
}

join_rules() {
  local file="$1"
  [ -r "$file" ] || die "找不到规则文件：$file"
  awk 'NF && $1 !~ /^#/ { printf "%s%s", sep, $1; sep=", " } END { print "" }' "$file"
}

render_redsocks_conf() {
  cat > "$REDSOCKS_CONF" <<EOF
base {
  log_debug = off;
  log_info = on;
  log = "syslog:daemon";
  daemon = off;
  redirector = iptables;
}

redsocks {
  local_ip = 127.0.0.1;
  local_port = ${REDSOCKS_PORT};
  ip = 127.0.0.1;
  port = ${WARP_SOCKS_PORT};
  type = socks5;
}
EOF
  chmod 0644 "$REDSOCKS_CONF"
}

render_nft_conf() {
  local google4 google6 redirect_rules
  validate_rules_file "${RULES_DIR}/google_ipv4.txt" 4
  validate_rules_file "${RULES_DIR}/google_ipv6.txt" 6
  google4="$(join_rules "${RULES_DIR}/google_ipv4.txt")"
  google6="$(join_rules "${RULES_DIR}/google_ipv6.txt")"
  [ -n "$google4" ] || die "IPv4 规则为空"
  [ -n "$google6" ] || die "IPv6 规则为空"

  if [ "$WARP_SCOPE" = "global" ]; then
    redirect_rules="$(cat <<EOF
add rule inet warp_vps output_nat ct direction reply return
add rule inet warp_vps output_nat meta nfproto ipv4 meta l4proto tcp counter redirect to :${REDSOCKS_PORT}
EOF
)"
  else
    redirect_rules="add rule inet warp_vps output_nat ip daddr @google4 meta l4proto tcp counter redirect to :${REDSOCKS_PORT}"
  fi

  local table_action
  if table_exists; then
    table_action=$'delete table inet warp_vps\nadd table inet warp_vps'
  else
    table_action="add table inet warp_vps"
  fi

  cat > "$NFT_CONF" <<EOF
${table_action}
add set inet warp_vps google4 { type ipv4_addr; flags interval; auto-merge; elements = { ${google4} }; }
add set inet warp_vps google6 { type ipv6_addr; flags interval; auto-merge; elements = { ${google6} }; }
add chain inet warp_vps output_nat { type nat hook output priority -100; policy accept; }
add rule inet warp_vps output_nat meta skuid ${REDSOCKS_UID} return
add rule inet warp_vps output_nat oifname "lo" return
add rule inet warp_vps output_nat ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 } return
${redirect_rules}
add chain inet warp_vps output_filter { type filter hook output priority filter; policy accept; }
add rule inet warp_vps output_filter meta skuid ${REDSOCKS_UID} return
add rule inet warp_vps output_filter oifname "lo" return
add rule inet warp_vps output_filter ip daddr @google4 udp dport 443 counter reject with icmpx type admin-prohibited
add rule inet warp_vps output_filter ip6 daddr @google6 counter reject with icmpx type admin-prohibited
EOF
  chmod 0644 "$NFT_CONF"
}

wg_interface_exists() {
  ip link show "$WG_IFACE" >/dev/null 2>&1
}

wg_interface_is_wireguard() {
  wg show "$WG_IFACE" >/dev/null 2>&1
}

wg_interface_absent() {
  local links state
  links="$(ip -o link show 2>/dev/null)" || return 2
  state="$(awk -F ': ' -v iface="$WG_IFACE" '
    {
      name=$2
      sub(/@.*/, "", name)
      if (name == iface) found=1
    }
    END { print found ? "present" : "absent" }
  ' <<< "$links")" || return 2
  case "$state" in
    absent) return 0 ;;
    present) return 1 ;;
    *) return 2 ;;
  esac
}

ssh_peer_ip() {
  [ -n "${SSH_CONNECTION:-}" ] || return 1
  printf '%s\n' "${SSH_CONNECTION%% *}"
}

ip_in_google_rules() {
  local ip="$1"
  python3 - "$ip" "${RULES_DIR}/google_ipv4.txt" "${RULES_DIR}/google_ipv6.txt" <<'PY'
import ipaddress
import pathlib
import sys

addr = ipaddress.ip_address(sys.argv[1])
for file_name in sys.argv[2:]:
    path = pathlib.Path(file_name)
    if not path.exists():
        continue
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if addr in ipaddress.ip_network(line, strict=True):
            raise SystemExit(2)
PY
}

protect_ssh_peer_route() {
  local peer rc
  peer="$(ssh_peer_ip || true)"
  [ -n "$peer" ] || return 0
  rc=0
  ip_in_google_rules "$peer" || rc=$?
  case "$rc" in
    0) return 0 ;;
    2) die "当前 SSH 来源 IP 命中 Google 规则，WireGuard 路由可能导致 SSH 失联，已中止" ;;
    *) die "无法完成 SSH 来源 IP 路由安全检查" ;;
  esac
}

wgcf_asset_spec() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'wgcf_2.2.32_linux_amd64\n' ;;
    aarch64|arm64) printf 'wgcf_2.2.32_linux_arm64\n' ;;
    armv7l) printf 'wgcf_2.2.32_linux_armv7\n' ;;
    armv6l) printf 'wgcf_2.2.32_linux_armv6\n' ;;
    armv5*) printf 'wgcf_2.2.32_linux_armv5\n' ;;
    i386|i486|i586|i686) printf 'wgcf_2.2.32_linux_386\n' ;;
    mips) printf 'wgcf_2.2.32_linux_mips_softfloat\n' ;;
    mipsel|mipsle) printf 'wgcf_2.2.32_linux_mipsle_softfloat\n' ;;
    mips64) printf 'wgcf_2.2.32_linux_mips64_softfloat\n' ;;
    mips64el|mips64le) printf 'wgcf_2.2.32_linux_mips64le_softfloat\n' ;;
    s390x) printf 'wgcf_2.2.32_linux_s390x\n' ;;
    *) die "WireGuard 模式暂不支持当前 CPU 架构：$(uname -m)" ;;
  esac
}

install_wgcf_binary() {
  if [ "$WGCF_BIN" != "$DEFAULT_WGCF_BIN" ] && [ -x "$WGCF_BIN" ]; then
    return 0
  fi
  install -d -m 0755 "$(dirname "$WGCF_BIN")"
  local asset_name url staged
  asset_name="$(wgcf_asset_spec)"
  url="https://github.com/ViRb3/wgcf/releases/download/${DEFAULT_WGCF_VERSION}/${asset_name}"
  staged="${WGCF_BIN}.new.$$"
  curl -LfsS --connect-timeout 10 --max-time 120 "$url" -o "$staged" \
    || die "wgcf 下载失败：$asset_name"
  chmod 0755 "$staged" || die "无法设置 wgcf 执行权限"
  mv "$staged" "$WGCF_BIN" || die "无法激活 wgcf：$WGCF_BIN"
  log "已下载 wgcf：${DEFAULT_WGCF_VERSION} ${asset_name}"
}

run_wgcf_command() {
  command -v timeout >/dev/null 2>&1 || die "找不到 timeout，无法限制 wgcf 执行时间"
  timeout -k 5 "$WGCF_OPERATION_TIMEOUT" "$WGCF_BIN" "$@"
}

wg_config_valid() {
  local file="$1"
  [ -s "$file" ] || return 1
  wg-quick strip "$file" >/dev/null 2>&1 || return 1
  python3 - "$file" >/dev/null 2>&1 <<'PY'
import base64
import binascii
import ipaddress
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
interface = None
peers = []
current = None
current_kind = None
allowed_keys = {
    "interface": {"privatekey", "address", "mtu", "table"},
    "peer": {"publickey", "allowedips", "endpoint"},
}

for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.split("#", 1)[0].strip()
    if not line:
        continue
    if line.startswith("[") and line.endswith("]"):
        section = line[1:-1].strip().lower()
        if section == "interface":
            if interface is not None:
                raise SystemExit("duplicate interface")
            interface = {}
            current = interface
            current_kind = "interface"
        elif section == "peer":
            current = {}
            peers.append(current)
            current_kind = "peer"
        else:
            raise SystemExit("unknown section")
        continue
    if current is None or "=" not in line:
        raise SystemExit("invalid line")
    key, value = line.split("=", 1)
    key = key.strip().lower()
    if key not in allowed_keys[current_kind]:
        raise SystemExit("unknown key")
    current.setdefault(key, []).append(value.strip())

def entries(section, key):
    values = []
    for raw_value in section.get(key, []):
        values.extend(item.strip() for item in raw_value.split(",") if item.strip())
    return values

def valid_key(value):
    try:
        return len(base64.b64decode(value, validate=True)) == 32
    except (binascii.Error, ValueError):
        return False

def valid_endpoint(value):
    if not value or any(ch.isspace() for ch in value):
        return False
    if value.startswith("["):
        close = value.find("]")
        if close <= 1 or value[close + 1:close + 2] != ":":
            return False
        host = value[1:close]
        port = value[close + 2:]
        try:
            if ipaddress.ip_address(host).version != 6:
                return False
        except ValueError:
            return False
    else:
        if value.count(":") != 1:
            return False
        host, port = value.rsplit(":", 1)
        if not host:
            return False
    return port.isdigit() and 1 <= int(port) <= 65535

if interface is None:
    raise SystemExit("missing interface")
private_keys = entries(interface, "privatekey")
if len(private_keys) != 1 or not valid_key(private_keys[0]):
    raise SystemExit("invalid private key")
addresses = entries(interface, "address")
if not addresses:
    raise SystemExit("missing address")
address_versions = set()
for address in addresses:
    address_versions.add(ipaddress.ip_interface(address).version)
if 4 not in address_versions:
    raise SystemExit("missing IPv4 interface address")
if 6 not in address_versions:
    raise SystemExit("missing IPv6 interface address")
mtus = entries(interface, "mtu")
if len(mtus) > 1 or (mtus and (not mtus[0].isdigit() or not 576 <= int(mtus[0]) <= 65535)):
    raise SystemExit("invalid mtu")
tables = entries(interface, "table")
if len(tables) != 1 or tables[0] != "off":
    raise SystemExit("table must be off")
if not peers:
    raise SystemExit("missing peer")

for peer in peers:
    public_keys = entries(peer, "publickey")
    if len(public_keys) != 1 or not valid_key(public_keys[0]):
        raise SystemExit("invalid peer key")
    endpoints = entries(peer, "endpoint")
    if len(endpoints) != 1 or not valid_endpoint(endpoints[0]):
        raise SystemExit("invalid endpoint")
    allowed = entries(peer, "allowedips")
    networks = {ipaddress.ip_network(value, strict=False) for value in allowed}
    if ipaddress.ip_network("0.0.0.0/0") not in networks:
        raise SystemExit("missing IPv4 default route")
    if ipaddress.ip_network("::/0") not in networks:
        raise SystemExit("missing IPv6 default route")
PY
}

generate_wg_config() {
  if [ -r "$WG_CONFIG" ] && wg_config_valid "$WG_CONFIG"; then
    return 0
  fi

  local stage fresh profile_dir account_source config_stage config_tmp account_tmp backup_dir
  local wgcf_rc=0
  stage="${STATE_DIR}/wgcf-stage-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  fresh="${stage}/fresh"
  account_source="${STATE_DIR}/wgcf/wgcf-account.toml"
  config_stage="${stage}/${WG_IFACE}.conf"
  config_tmp="${WG_CONFIG}.new.$$"
  account_tmp="${account_source}.new.$$"
  backup_dir="${STATE_DIR}/wgcf/backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"

  install -d -m 0700 /etc/wireguard "${STATE_DIR}/wgcf" "$stage"
  install_wgcf_binary
  profile_dir=""
  if [ -s "$account_source" ]; then
    install -m 0600 "$account_source" "${stage}/wgcf-account.toml"
    if (
      cd "$stage"
      run_wgcf_command generate >/dev/null
    ); then
      profile_dir="$stage"
    else
      wgcf_rc=$?
      case "$wgcf_rc" in
        124|137) die "wgcf 生成 WireGuard 配置超时（${WGCF_OPERATION_TIMEOUT} 秒）" ;;
      esac
    fi
  fi

  if [ -z "$profile_dir" ]; then
    install -d -m 0700 "$fresh"
    wgcf_rc=0
    (
      cd "$fresh" \
        && run_wgcf_command register --accept-tos >/dev/null \
        && run_wgcf_command generate >/dev/null
    ) || wgcf_rc=$?
    if [ "$wgcf_rc" -ne 0 ]; then
      case "$wgcf_rc" in
        124|137) die "wgcf 注册或生成 WireGuard 配置超时（${WGCF_OPERATION_TIMEOUT} 秒）" ;;
        *) die "wgcf 注册或生成 WireGuard 配置失败" ;;
      esac
    fi
    profile_dir="$fresh"
  fi

  [ -s "${profile_dir}/wgcf-account.toml" ] || die "wgcf 没有生成账户文件"
  [ -s "${profile_dir}/wgcf-profile.conf" ] || die "wgcf 没有生成 WireGuard 配置"
  python3 - "${profile_dir}/wgcf-profile.conf" "$config_stage" <<'PY'
import pathlib
import sys

src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])
lines = src.read_text(encoding="utf-8").splitlines()
out = []
inserted = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("DNS"):
        continue
    if stripped.startswith("Table"):
        continue
    out.append(line)
    if stripped == "[Interface]" and not inserted:
        out.append("Table = off")
        inserted = True
if not inserted:
    raise SystemExit("WireGuard 配置缺少 [Interface]")
dst.write_text("\n".join(out).rstrip() + "\n", encoding="utf-8")
PY
  chmod 0600 "$config_stage"
  wg_config_valid "$config_stage" || die "wgcf 生成的 WireGuard 配置无法被 wg-quick 解析"

  if [ -e "$WG_CONFIG" ] || { [ -s "$account_source" ] && [ "$profile_dir" = "$fresh" ]; }; then
    install -d -m 0700 "$backup_dir"
    if [ -e "$WG_CONFIG" ]; then
      install -m 0600 "$WG_CONFIG" "${backup_dir}/$(basename "$WG_CONFIG").invalid" \
        || die "无法备份旧 WireGuard 配置"
    fi
    if [ -s "$account_source" ] && [ "$profile_dir" = "$fresh" ]; then
      install -m 0600 "$account_source" "${backup_dir}/wgcf-account.toml.invalid" \
        || die "无法备份旧 wgcf 账户文件"
    fi
  fi

  install -m 0600 "$config_stage" "$config_tmp"
  mv "$config_tmp" "$WG_CONFIG"
  install -m 0600 "${profile_dir}/wgcf-account.toml" "$account_tmp"
  mv "$account_tmp" "$account_source"
}

route_file_lines() {
  local file="$1"
  awk 'NF && $1 !~ /^#/ { print $1 }' "$file"
}

rule_probe_ip() {
  local file="$1"
  local version="$2"
  python3 - "$file" "$version" <<'PY'
import ipaddress
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
version = int(sys.argv[2])
for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    network = ipaddress.ip_network(line, strict=True)
    if network.version != version:
        raise SystemExit(f"unexpected IPv{network.version} rule in {path}")
    print(network.network_address)
    raise SystemExit(0)
raise SystemExit(f"no IPv{version} rules in {path}")
PY
}

wg_global_nft_table_absent() {
  if ! command -v nft >/dev/null 2>&1; then
    [ "${WARP_MODE:-}" != "wireguard" ] || [ "${WARP_SCOPE:-google}" != "global" ]
    return
  fi
  local tables
  tables="$(nft list tables 2>/dev/null)" || return 1
  ! grep -Fxq "table inet ${WG_GLOBAL_NFT_TABLE}" <<< "$tables"
}

render_wg_global_nft_conf() {
  local table_action
  if nft list table inet "$WG_GLOBAL_NFT_TABLE" >/dev/null 2>&1; then
    table_action=$'delete table inet warp_vps_global\nadd table inet warp_vps_global'
  else
    table_action="add table inet ${WG_GLOBAL_NFT_TABLE}"
  fi
  cat > "$NFT_CONF" <<EOF
${table_action}
add chain inet ${WG_GLOBAL_NFT_TABLE} prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet ${WG_GLOBAL_NFT_TABLE} output { type route hook output priority mangle; policy accept; }
add chain inet ${WG_GLOBAL_NFT_TABLE} postrouting { type filter hook postrouting priority mangle; policy accept; }
add rule inet ${WG_GLOBAL_NFT_TABLE} prerouting ct mark ${WG_GLOBAL_MARK} meta mark set ct mark
add rule inet ${WG_GLOBAL_NFT_TABLE} prerouting iifname != "lo" iifname != "${WG_IFACE}" fib daddr type local ct direction original meta mark set ${WG_GLOBAL_MARK} ct mark set meta mark
add rule inet ${WG_GLOBAL_NFT_TABLE} output ct mark ${WG_GLOBAL_MARK} meta mark set ct mark
add rule inet ${WG_GLOBAL_NFT_TABLE} postrouting meta l4proto udp meta mark ${WG_GLOBAL_MARK} ct mark set meta mark
EOF
  chmod 0644 "$NFT_CONF"
}

wg_global_src_valid_mark_ok() {
  [ -r "$WG_GLOBAL_SRC_VALID_MARK_PATH" ] || return 1
  [ "$(< "$WG_GLOBAL_SRC_VALID_MARK_PATH")" = "1" ]
}

enable_wg_global_src_valid_mark() {
  wg_global_src_valid_mark_ok && return 0
  if [ ! -w "$WG_GLOBAL_SRC_VALID_MARK_PATH" ]; then
    die "WireGuard 全局模式无法启用入站连接回包标记"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi
  if ! printf '1\n' > "$WG_GLOBAL_SRC_VALID_MARK_PATH"; then
    die "WireGuard 全局模式无法启用入站连接回包标记"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi
}

wg_global_policy_rules_absent() {
  local family rules mark_pattern
  mark_pattern='(0x0*ca[bB]0|51888)'
  for family in 4 6; do
    rules="$(ip -"$family" rule show 2>/dev/null)" || return 1
    ! grep -Eq "^${WG_GLOBAL_MAIN_RULE_PRIORITY}:.*lookup main.*suppress_prefixlength 0([[:space:]]|$)" \
      <<< "$rules" || return 1
    ! grep -Eq "^${WG_GLOBAL_RULE_PRIORITY}:.*not .*fwmark ${mark_pattern}(/0x[fF]{8})?.*lookup ${WG_GLOBAL_TABLE}([[:space:]]|$)" \
      <<< "$rules" || return 1
  done
}

wg_global_routes_absent() {
  local family routes
  for family in 4 6; do
    routes="$(ip -"$family" route show table all default 2>/dev/null)" || return 1
    ! grep -Eq "(^|[[:space:]])table ${WG_GLOBAL_TABLE}([[:space:]]|$)" <<< "$routes" \
      || return 1
  done
  wg_global_policy_rules_absent && wg_global_nft_table_absent
}

delete_wg_global_policy_rules() {
  local family
  for family in 4 6; do
    while ip -"$family" rule del not fwmark "$WG_GLOBAL_MARK" \
      table "$WG_GLOBAL_TABLE" priority "$WG_GLOBAL_RULE_PRIORITY" >/dev/null 2>&1; do
      :
    done
    while ip -"$family" rule del table main suppress_prefixlength 0 \
      priority "$WG_GLOBAL_MAIN_RULE_PRIORITY" >/dev/null 2>&1; do
      :
    done
  done
}

stop_wg_global_routes() {
  delete_wg_global_policy_rules
  ip -4 route del default dev "$WG_IFACE" table "$WG_GLOBAL_TABLE" >/dev/null 2>&1 || true
  ip -6 route del default dev "$WG_IFACE" table "$WG_GLOBAL_TABLE" >/dev/null 2>&1 || true
  if command -v nft >/dev/null 2>&1 \
    && nft list table inet "$WG_GLOBAL_NFT_TABLE" >/dev/null 2>&1; then
    nft delete table inet "$WG_GLOBAL_NFT_TABLE" >/dev/null 2>&1 || true
  fi
  if wg_interface_is_wireguard; then
    wg set "$WG_IFACE" fwmark off >/dev/null 2>&1 || true
  fi
}

apply_wg_global_routes() {
  command -v nft >/dev/null 2>&1 || die "WireGuard 全局模式需要 nftables"
  stop_wg_global_routes
  enable_wg_global_src_valid_mark || return 1
  render_wg_global_nft_conf
  nft -c -f "$NFT_CONF" || die "WireGuard 全局回包规则预检失败"
  if ! nft -f "$NFT_CONF"; then
    stop_wg_global_routes
    die "WireGuard 全局回包规则加载失败，已清除本项目全局规则"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi
  if ! wg set "$WG_IFACE" fwmark "$WG_GLOBAL_MARK" \
    || ! ip -4 route replace default dev "$WG_IFACE" table "$WG_GLOBAL_TABLE" \
    || ! ip -6 route replace default dev "$WG_IFACE" table "$WG_GLOBAL_TABLE" \
    || ! ip -4 rule add priority "$WG_GLOBAL_MAIN_RULE_PRIORITY" table main suppress_prefixlength 0 \
    || ! ip -6 rule add priority "$WG_GLOBAL_MAIN_RULE_PRIORITY" table main suppress_prefixlength 0 \
    || ! ip -4 rule add not fwmark "$WG_GLOBAL_MARK" table "$WG_GLOBAL_TABLE" priority "$WG_GLOBAL_RULE_PRIORITY" \
    || ! ip -6 rule add not fwmark "$WG_GLOBAL_MARK" table "$WG_GLOBAL_TABLE" priority "$WG_GLOBAL_RULE_PRIORITY"; then
    stop_wg_global_routes
    die "WireGuard 全局路由写入失败，已清除本项目全局路由"
    # Tests replace die() to inspect this failure path.
    # shellcheck disable=SC2317
    return 1
  fi
}

apply_wg_routes() {
  local cidr cleanup_message
  load_config
  if [ "$WARP_SCOPE" = "google" ]; then
    validate_rules_file "${RULES_DIR}/google_ipv4.txt" 4
    validate_rules_file "${RULES_DIR}/google_ipv6.txt" 6
  fi
  wg_interface_is_wireguard || die "同名网卡不存在或不是 WireGuard：$WG_IFACE"
  stop_wg_routes
  if [ "$WARP_SCOPE" = "global" ]; then
    apply_wg_global_routes
    return
  fi
  protect_ssh_peer_route
  while IFS= read -r cidr; do
    if ! ip -4 route replace "$cidr" dev "$WG_IFACE"; then
      if stop_wg_routes_strict; then
        cleanup_message="已清除本项目路由"
      else
        cleanup_message="无法确认本项目路由已完整清除"
      fi
      die "Google IPv4 路由写入失败，${cleanup_message}：$cidr"
      # Tests replace die() to inspect this failure path.
      # shellcheck disable=SC2317
      return 1
    fi
  done < <(route_file_lines "${RULES_DIR}/google_ipv4.txt")
  while IFS= read -r cidr; do
    if ! ip -6 route replace "$cidr" dev "$WG_IFACE"; then
      if stop_wg_routes_strict; then
        cleanup_message="已清除本项目路由"
      else
        cleanup_message="无法确认本项目路由已完整清除"
      fi
      die "Google IPv6 路由写入失败，${cleanup_message}：$cidr"
      # Tests replace die() to inspect this failure path.
      # shellcheck disable=SC2317
      return 1
    fi
  done < <(route_file_lines "${RULES_DIR}/google_ipv6.txt")
}

stop_wg_routes() {
  local cidr
  if [ -r "${RULES_DIR}/google_ipv4.txt" ]; then
    while IFS= read -r cidr; do
      ip -4 route del "$cidr" dev "${WG_IFACE:-$DEFAULT_WG_IFACE}" 2>/dev/null || true
    done < <(route_file_lines "${RULES_DIR}/google_ipv4.txt")
  fi
  if [ -r "${RULES_DIR}/google_ipv6.txt" ]; then
    while IFS= read -r cidr; do
      ip -6 route del "$cidr" dev "${WG_IFACE:-$DEFAULT_WG_IFACE}" 2>/dev/null || true
    done < <(route_file_lines "${RULES_DIR}/google_ipv6.txt")
  fi
  stop_wg_global_routes
}

stop_wg_routes_strict() {
  local cidr routes interface_rc cidrs4 cidrs6
  local failed=0
  local iface="${WG_IFACE:-$DEFAULT_WG_IFACE}"

  stop_wg_global_routes
  wg_global_routes_absent || failed=1
  interface_rc=0
  wg_interface_absent || interface_rc=$?
  case "$interface_rc" in
    0) [ "$failed" -eq 0 ]; return ;;
    1) ;;
    *) return 1 ;;
  esac
  if ! wg_interface_exists; then
    if wg_interface_absent; then
      [ "$failed" -eq 0 ]
      return
    fi
    return 1
  fi

  [ -r "${RULES_DIR}/google_ipv4.txt" ] || return 1
  [ -r "${RULES_DIR}/google_ipv6.txt" ] || return 1
  validate_rules_file "${RULES_DIR}/google_ipv4.txt" 4 || return 1
  validate_rules_file "${RULES_DIR}/google_ipv6.txt" 6 || return 1
  cidrs4="$(route_file_lines "${RULES_DIR}/google_ipv4.txt")" || return 1
  cidrs6="$(route_file_lines "${RULES_DIR}/google_ipv6.txt")" || return 1

  while IFS= read -r cidr; do
    routes=""
    if ! routes="$(ip -4 route show exact "$cidr" dev "$iface" 2>/dev/null)"; then
      failed=1
      continue
    fi
    if [ -n "$routes" ] && ! ip -4 route del "$cidr" dev "$iface"; then
      failed=1
    fi
  done <<< "$cidrs4"
  while IFS= read -r cidr; do
    routes=""
    if ! routes="$(ip -6 route show exact "$cidr" dev "$iface" 2>/dev/null)"; then
      failed=1
      continue
    fi
    if [ -n "$routes" ] && ! ip -6 route del "$cidr" dev "$iface"; then
      failed=1
    fi
  done <<< "$cidrs6"

  while IFS= read -r cidr; do
    routes=""
    if ! routes="$(ip -4 route show exact "$cidr" dev "$iface" 2>/dev/null)"; then
      failed=1
    elif [ -n "$routes" ]; then
      failed=1
    fi
  done <<< "$cidrs4"
  while IFS= read -r cidr; do
    routes=""
    if ! routes="$(ip -6 route show exact "$cidr" dev "$iface" 2>/dev/null)"; then
      failed=1
    elif [ -n "$routes" ]; then
      failed=1
    fi
  done <<< "$cidrs6"
  wg_global_routes_absent || failed=1
  [ "$failed" -eq 0 ]
}

remove_wireguard_interface() {
  local iface="${WG_IFACE:-$DEFAULT_WG_IFACE}"
  local config="${WG_CONFIG:-/etc/wireguard/${iface}.conf}"
  stop_wg_routes
  if wg_interface_absent; then
    return 0
  fi
  wg-quick down "$config" >/dev/null 2>&1 \
    || wg-quick down "$iface" >/dev/null 2>&1 \
    || true
  if ! wg_interface_absent; then
    ip link delete dev "$iface" >/dev/null 2>&1 || true
  fi
  wg_interface_absent
}

table_exists() {
  nft list table inet warp_vps >/dev/null 2>&1
}

socks_table_absent() {
  command -v nft >/dev/null 2>&1 || return 0
  local tables rc
  tables="$(nft list tables 2>/dev/null)" || return 1
  rc=0
  grep -Fxq 'table inet warp_vps' <<< "$tables" || rc=$?
  case "$rc" in
    0) return 1 ;;
    1) return 0 ;;
    *) return 2 ;;
  esac
}

clear_socks_table_for_wireguard() {
  command -v nft >/dev/null 2>&1 || return 0
  local tables rc
  tables="$(nft list tables 2>/dev/null)" || return 1
  rc=0
  grep -Fxq 'table inet warp_vps' <<< "$tables" || rc=$?
  case "$rc" in
    0) nft delete table inet warp_vps || return 1 ;;
    1) return 0 ;;
    *) return 1 ;;
  esac
  socks_table_absent
}

apply_rules() {
  load_config
  validate_repo_raw_base "$REPO_RAW_BASE"
  install -d -m 0755 "$ETC_DIR"
  if [ "$WARP_MODE" = "wireguard" ]; then
    clear_socks_table_for_wireguard || die "无法清除旧 Socks5 分流规则"
    apply_wg_routes
    return
  fi
  stop_wg_routes
  render_redsocks_conf
  render_nft_conf
  nft -c -f "$NFT_CONF"
  nft -f "$NFT_CONF"
}

stop_rules() {
  if [ -r "$CONFIG_FILE" ]; then
    load_config
    if [ "$WARP_MODE" = "wireguard" ]; then
      stop_wg_routes
      return
    fi
    stop_wg_routes
  fi
  if table_exists; then
    nft delete table inet warp_vps
  fi
}

load_uninstall_config() {
  local line key value mode_present iface_invalid
  mode_present=0
  iface_invalid=0
  UNINSTALL_WG_CONFIG_EXPLICIT=0
  UNINSTALL_WIREGUARD_PRESENT=0
  UNINSTALL_RUNTIME_IDENTIFIED=0
  unset WARP_MODE WARP_SCOPE WG_IFACE WG_CONFIG MANAGED_WARP_SVC REDSOCKS_BIN MANAGED_REDSOCKS_BIN
  if [ -r "$CONFIG_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        WARP_MODE=*|WARP_SCOPE=*|WG_IFACE=*|WG_CONFIG=*|MANAGED_WARP_SVC=*|REDSOCKS_BIN=*|MANAGED_REDSOCKS_BIN=*) ;;
        *) continue ;;
      esac
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        WARP_MODE)
          case "$value" in
            socks|wireguard)
              WARP_MODE="$value"
              mode_present=1
              ;;
          esac
          ;;
        WARP_SCOPE)
          case "$value" in
            google|global) WARP_SCOPE="$value" ;;
          esac
          ;;
        WG_IFACE)
          if valid_config_iface "$value"; then
            WG_IFACE="$value"
          else
            iface_invalid=1
          fi
          ;;
        WG_CONFIG)
          if valid_config_path "$value"; then
            WG_CONFIG="$value"
            UNINSTALL_WG_CONFIG_EXPLICIT=1
          fi
          ;;
        MANAGED_WARP_SVC)
          case "$value" in 0|1) MANAGED_WARP_SVC="$value" ;; esac
          ;;
        REDSOCKS_BIN)
          if valid_config_path "$value"; then
            REDSOCKS_BIN="$value"
          fi
          ;;
        MANAGED_REDSOCKS_BIN)
          case "$value" in 0|1) MANAGED_REDSOCKS_BIN="$value" ;; esac
          ;;
      esac
    done < "$CONFIG_FILE"
  fi
  WG_IFACE="${WG_IFACE:-$DEFAULT_WG_IFACE}"
  WG_CONFIG="${WG_CONFIG:-/etc/wireguard/${WG_IFACE}.conf}"
  WARP_SCOPE="${WARP_SCOPE:-google}"
  if [ "${WARP_MODE:-}" = "wireguard" ]; then
    UNINSTALL_WIREGUARD_PRESENT=1
  fi
  if [ "$mode_present" -eq 1 ]; then
    if [ "$WARP_MODE" = "socks" ] || [ "$iface_invalid" -eq 0 ]; then
      UNINSTALL_RUNTIME_IDENTIFIED=1
    fi
  fi
  if [ -z "${MANAGED_WARP_SVC:-}" ]; then
    if [ "$mode_present" -eq 1 ] && [ "$WARP_MODE" = "socks" ]; then
      MANAGED_WARP_SVC=1
    else
      MANAGED_WARP_SVC=0
    fi
  fi
  if [ -z "${MANAGED_REDSOCKS_BIN:-}" ]; then
    MANAGED_REDSOCKS_BIN=0
    if managed_redsocks_fallback_exists; then
      MANAGED_REDSOCKS_BIN=1
    fi
  fi
}

recover_uninstall_runtime_from_unit() {
  local unit_file candidate line
  unit_file="/etc/systemd/system/warp-vps.service"
  if [ -r "$unit_file" ] && grep -q 'wg-quick@' "$unit_file"; then
    candidate=""
    while IFS= read -r line; do
      case "$line" in
        *wg-quick@*.service*)
          candidate="${line#*wg-quick@}"
          candidate="${candidate%%.service*}"
          valid_config_iface "$candidate" && break
          candidate=""
          ;;
      esac
    done < "$unit_file"
    if valid_config_iface "$candidate"; then
      WG_IFACE="$candidate"
      if [ "$UNINSTALL_WG_CONFIG_EXPLICIT" -eq 0 ]; then
        WG_CONFIG="/etc/wireguard/${WG_IFACE}.conf"
      fi
      UNINSTALL_WIREGUARD_PRESENT=1
      UNINSTALL_RUNTIME_IDENTIFIED=1
      WARP_MODE="${WARP_MODE:-wireguard}"
    fi
  elif [ -r "$unit_file" ] && grep -q 'warp-vps-redsocks\.service' "$unit_file"; then
    UNINSTALL_RUNTIME_IDENTIFIED=1
    WARP_MODE="${WARP_MODE:-socks}"
  fi
  WARP_MODE="${WARP_MODE:-socks}"
  if [ -e "$WG_CONFIG" ]; then
    UNINSTALL_WIREGUARD_PRESENT=1
  fi
}

uninstall_nft_table_exists() {
  local table="${1:-warp_vps}"
  local tables rc
  tables="$(nft list tables 2>/dev/null)" \
    || die "无法读取 nftables 当前状态，不能确认分流规则已经失效"
  rc=0
  grep -Fxq "table inet ${table}" <<< "$tables" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "无法解析 nftables 当前状态，不能确认分流规则已经失效" ;;
  esac
}

uninstall_wg_interface_exists() {
  local links rc
  links="$(ip -o link show 2>/dev/null)" \
    || die "无法读取网卡当前状态，不能确认 WireGuard 分流已经失效"
  rc=0
  awk -F ': ' -v iface="$WG_IFACE" '
    {
      name=$2
      sub(/@.*/, "", name)
      if (name == iface) found=1
    }
    END { exit !found }
  ' <<< "$links" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "无法解析网卡当前状态，不能确认 WireGuard 分流已经失效" ;;
  esac
}

stop_rules_for_uninstall() {
  if command -v ip >/dev/null 2>&1; then
    stop_wg_routes
  fi
  if command -v nft >/dev/null 2>&1; then
    if uninstall_nft_table_exists; then
      nft delete table inet warp_vps || die "无法删除本项目 nftables 分流规则"
    fi
    if uninstall_nft_table_exists; then
      die "本项目 nftables 分流规则仍在生效，卸载已中止"
    fi
    if uninstall_nft_table_exists "$WG_GLOBAL_NFT_TABLE"; then
      nft delete table inet "$WG_GLOBAL_NFT_TABLE" \
        || die "无法删除本项目 WireGuard 全局回包规则"
    fi
    if uninstall_nft_table_exists "$WG_GLOBAL_NFT_TABLE"; then
      die "本项目 WireGuard 全局回包规则仍在生效，卸载已中止"
    fi
  elif [ "${WARP_MODE:-socks}" = "socks" ] || [ "${WARP_SCOPE:-google}" = "global" ]; then
    die "找不到 nft 命令，无法确认本项目分流规则已经失效"
  fi
  if command -v ip >/dev/null 2>&1 && ! wg_global_routes_absent; then
    die "本项目 WireGuard 全局路由仍在生效，卸载已中止"
  fi
}

install_systemd() {
  require_root
  load_config
  install -d -m 0755 "$ETC_DIR"
  if [ "$WARP_MODE" = "socks" ]; then
    render_redsocks_conf

    cat > /etc/systemd/system/warp-vps-redsocks.service <<EOF
[Unit]
Description=WARP VPS Manager redsocks 转发服务
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=simple
User=${REDSOCKS_USER}
Group=${REDSOCKS_GROUP}
ExecStart=${REDSOCKS_BIN} -c ${REDSOCKS_CONF}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
EOF
  fi

  local route_after="network-online.target warp-svc.service warp-vps-redsocks.service"
  local route_wants="network-online.target warp-vps-redsocks.service"
  if [ "$WARP_MODE" = "wireguard" ]; then
    route_after="network-online.target wg-quick@${WG_IFACE}.service"
    route_wants="network-online.target wg-quick@${WG_IFACE}.service"
  fi

  cat > /etc/systemd/system/warp-vps.service <<EOF
[Unit]
Description=WARP VPS Manager 系统级路由
After=${route_after}
Wants=${route_wants}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=${BIN_PATH} apply
ExecStop=${BIN_PATH} stop-rules

[Install]
WantedBy=multi-user.target
EOF

  cat > /etc/systemd/system/warp-vps-health.service <<EOF
[Unit]
Description=WARP VPS Manager 健康检查
After=network-online.target warp-vps.service

[Service]
Type=oneshot
ExecStart=${BIN_PATH} heal
EOF

  cat > /etc/systemd/system/warp-vps-health.timer <<'EOF'
[Unit]
Description=定时运行 WARP VPS Manager 健康检查

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
EOF
}

port_listening() {
  ss -H -ltn "sport = :$1" 2>/dev/null | grep -q .
}

service_owns_listening_port() {
  local unit="$1"
  local port="$2"
  local listeners identity main_pid control_group pids pid cgroup_line cgroup_path
  service_active "$unit" || return 1
  listeners="$(ss -H -ltnp "sport = :${port}" 2>/dev/null)" || return 1
  [ -n "$listeners" ] || return 1
  pids="$(grep -oE 'pid=[0-9]+' <<< "$listeners" | cut -d= -f2 | sort -u)" || return 1
  [ -n "$pids" ] || return 1
  identity="$(systemctl show "$unit" -p MainPID -p ControlGroup --no-pager 2>/dev/null)" \
    || return 1
  main_pid="$(awk -F= '$1 == "MainPID" { print $2; exit }' <<< "$identity")"
  control_group="$(awk -F= '$1 == "ControlGroup" { print $2; exit }' <<< "$identity")"
  case "$main_pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$main_pid" -gt 0 ] || return 1

  while IFS= read -r pid; do
    [ "$pid" = "$main_pid" ] && return 0
    [ -n "$control_group" ] || continue
    [ -r "/proc/${pid}/cgroup" ] || continue
    while IFS= read -r cgroup_line; do
      cgroup_path="${cgroup_line##*:}"
      case "$cgroup_path" in
        "$control_group"|"${control_group}/"*) return 0 ;;
      esac
    done < "/proc/${pid}/cgroup"
  done <<< "$pids"
  return 1
}

socks5_greeting_ok() {
  local port="$1"
  python3 - "$port" >/dev/null 2>&1 <<'PY'
import socket
import sys

port = int(sys.argv[1])
with socket.create_connection(("127.0.0.1", port), timeout=2) as client:
    client.settimeout(2)
    client.sendall(b"\x05\x01\x00")
    response = bytearray()
    while len(response) < 2:
        chunk = client.recv(2 - len(response))
        if not chunk:
            break
        response.extend(chunk)
if bytes(response) != b"\x05\x00":
    raise SystemExit(1)
PY
}

warp_proxy_local_ready() {
  service_owns_listening_port warp-svc.service "$WARP_SOCKS_PORT" \
    && socks5_greeting_ok "$WARP_SOCKS_PORT"
}

redsocks_local_ready() {
  service_owns_listening_port warp-vps-redsocks.service "$REDSOCKS_PORT"
}

wait_for_redsocks_ready() {
  local max_wait="${1:-20}"
  local deadline=$((SECONDS + max_wait))
  while true; do
    redsocks_local_ready && return 0
    [ "$SECONDS" -ge "$deadline" ] && return 1
    sleep 1
  done
}

wait_for_socks_listen() {
  local max_wait="${1:-20}"
  local deadline=$((SECONDS + max_wait))
  while true; do
    warp_proxy_local_ready && return 0
    [ "$SECONDS" -ge "$deadline" ] && return 1
    sleep 1
  done
}

socks_trace() {
  curl --socks5-hostname "127.0.0.1:${WARP_SOCKS_PORT}" -fsS --connect-timeout 8 --max-time 15 \
    https://www.cloudflare.com/cdn-cgi/trace
}

socks_ok() {
  socks_trace 2>/dev/null | grep -Eq '^warp=(on|plus)$'
}

wg_handshake_recent() {
  local latest now
  latest="$(wg show "$WG_IFACE" latest-handshakes 2>/dev/null | awk 'NR == 1 { print $2 }')"
  case "$latest" in ''|*[!0-9]*) return 1 ;; esac
  [ "$latest" -gt 0 ] || return 1
  now="$(date +%s)"
  [ $((now - latest)) -lt 600 ]
}

wait_for_wg_ready() {
  local timeout="${1:-20}"
  local end=$((SECONDS + timeout))
  while [ "$SECONDS" -le "$end" ]; do
    if wg_interface_is_wireguard; then
      return 0
    fi
    sleep 2
  done
  return 1
}

restart_wireguard_runtime() {
  systemctl stop "wg-quick@${WG_IFACE}.service" >/dev/null 2>&1 || true
  remove_wireguard_interface || return 1
  systemctl reset-failed "wg-quick@${WG_IFACE}.service" >/dev/null 2>&1 || true
  systemctl start "wg-quick@${WG_IFACE}.service" || return 1
  apply_rules || return 1
  wait_for_wg_ready 20
}

route_output_uses_interface() {
  local iface="$1"
  awk -v iface="$iface" '
    {
      for (i = 1; i < NF; i++) {
        if ($i == "dev" && $(i + 1) == iface) found = 1
      }
    }
    END { exit !found }
  '
}

socks_wireguard_routes_absent() {
  local probe4 route4 defaults4 defaults6
  probe4="$(rule_probe_ip "${RULES_DIR}/google_ipv4.txt" 4)" || return 1
  route4="$(ip -4 route get "$probe4" 2>/dev/null)" || return 1
  if route_output_uses_interface "$WG_IFACE" <<< "$route4"; then
    return 1
  fi
  defaults4="$(ip -4 route show default 2>/dev/null)" || return 1
  defaults6="$(ip -6 route show default 2>/dev/null)" || return 1
  if route_output_uses_interface "$WG_IFACE" <<< "$defaults4"; then
    return 1
  fi
  ! route_output_uses_interface "$WG_IFACE" <<< "$defaults6" \
    && wg_global_routes_absent
}

clear_socks_wireguard_routes() {
  local family defaults previous
  stop_wg_routes
  for family in 4 6; do
    while true; do
      defaults="$(ip -"$family" route show default 2>/dev/null)" || return 1
      route_output_uses_interface "$WG_IFACE" <<< "$defaults" || break
      previous="$defaults"
      ip -"$family" route del default dev "$WG_IFACE" >/dev/null 2>&1 || break
      defaults="$(ip -"$family" route show default 2>/dev/null)" || return 1
      [ "$defaults" != "$previous" ] || return 1
    done
  done
  socks_wireguard_routes_absent
}

google_counter() {
  nft list chain inet warp_vps output_nat 2>/dev/null \
    | awk '/redirect to :/ { for (i=1; i<=NF; i++) if ($i == "packets") { print $(i+1); exit } }'
}

service_active() {
  systemctl is-active --quiet "$1"
}

service_enabled() {
  systemctl is-enabled --quiet "$1"
}

ensure_health_timer() {
  local failed=0
  systemctl enable warp-vps-health.timer >/dev/null 2>&1 || failed=1
  systemctl start warp-vps-health.timer >/dev/null 2>&1 || failed=1
  if [ "$failed" -eq 1 ]; then
    warn "自动健康检查定时器未能启用；不影响当前分流运行"
  fi
  return 0
}

restore_health_timer_on_exit() {
  local rc=$?
  trap - EXIT
  set +e
  if [ "$HEALTH_MAINTENANCE_ARMED" -eq 1 ] && [ "$HEALTH_TIMER_WAS_ACTIVE" -eq 1 ]; then
    systemctl start warp-vps-health.timer >/dev/null 2>&1 \
      || warn "维护操作结束后无法恢复健康检查定时器"
  fi
  exit "$rc"
}

begin_runtime_maintenance() {
  if [ "$HEALTH_MAINTENANCE_ARMED" -eq 0 ]; then
    HEALTH_TIMER_WAS_ACTIVE=0
    if uninstall_unit_is_active warp-vps-health.timer; then
      HEALTH_TIMER_WAS_ACTIVE=1
    fi
    HEALTH_MAINTENANCE_ARMED=1
    trap restore_health_timer_on_exit EXIT
  fi
  systemctl stop warp-vps-health.timer >/dev/null 2>&1 || true
  systemctl stop warp-vps-health.service >/dev/null 2>&1 || true
  systemctl stop warp-vps-health.timer >/dev/null 2>&1 || true
  if uninstall_unit_is_active warp-vps-health.timer; then
    return 1
  fi
  if uninstall_unit_is_active warp-vps-health.service; then
    return 1
  fi
}

finish_runtime_maintenance() {
  ensure_health_timer
  HEALTH_MAINTENANCE_ARMED=0
  HEALTH_TIMER_WAS_ACTIVE=0
  trap - EXIT
}

unit_ready() {
  service_active "$1" && service_enabled "$1"
}

required_runtime_units_ready() {
  if [ "$WARP_MODE" = "wireguard" ]; then
    unit_ready "wg-quick@${WG_IFACE}.service" \
      && unit_ready warp-vps.service
    return
  fi
  unit_ready warp-svc.service \
    && unit_ready warp-vps-redsocks.service \
    && unit_ready warp-vps.service
}

warp_cli() {
  timeout 60 warp-cli "$@"
}

warp_output_registration_missing() {
  grep -Eiq 'registration.*(missing|required|not found|does not exist)|not registered|no .*registration' <<< "$1"
}

inspect_warp_registration() {
  local attempt show_output status_output combined rc
  WARP_REGISTRATION_STATE="unknown"
  WARP_REGISTRATION_DETAIL=""
  for attempt in 1 2 3 4 5 6; do
    rc=0
    show_output="$(timeout 10 warp-cli --accept-tos registration show 2>&1)" || rc=$?
    if warp_output_registration_missing "$show_output"; then
      WARP_REGISTRATION_STATE="missing"
      WARP_REGISTRATION_DETAIL="$show_output"
      return 0
    fi
    if [ "$rc" -eq 0 ]; then
      WARP_REGISTRATION_STATE="present"
      return 0
    fi
    status_output="$(timeout 10 warp-cli --accept-tos status 2>&1 || true)"
    combined="${show_output}"$'\n'"${status_output}"
    if warp_output_registration_missing "$combined"; then
      WARP_REGISTRATION_STATE="missing"
      WARP_REGISTRATION_DETAIL="$combined"
      return 0
    fi
    WARP_REGISTRATION_DETAIL="$combined"
    sleep 2
  done
  return 0
}

remember_warp_output() {
  local label="$1"
  local output="$2"
  [ -n "$output" ] || return 0
  WARP_RUNTIME_DETAILS="${WARP_RUNTIME_DETAILS}${label}:"$'\n'"${output}"$'\n'
}

create_warp_registration() {
  local output
  if output="$(warp_cli --accept-tos registration new 2>&1)"; then
    inspect_warp_registration
    return 0
  fi
  remember_warp_output "registration new" "$output"
  inspect_warp_registration
  [ "$WARP_REGISTRATION_STATE" = "present" ] && return 0
  [ "$WARP_REGISTRATION_STATE" = "missing" ] || return 1
  if output="$(warp_cli --accept-tos register 2>&1)"; then
    inspect_warp_registration
    return 0
  fi
  remember_warp_output "register" "$output"
  inspect_warp_registration
  [ "$WARP_REGISTRATION_STATE" = "present" ]
}

try_warp_command() {
  local label="$1"
  shift
  local output
  if output="$(warp_cli "$@" 2>&1)"; then
    return 0
  fi
  remember_warp_output "$label" "$output"
  return 1
}

wait_for_warp_proxy_ready() {
  wait_for_socks_listen "${1:-90}"
}

print_warp_diagnostics() {
  local status_output
  warn "Cloudflare WARP 本地代理没有就绪"
  warn "注册状态：${WARP_REGISTRATION_STATE}"
  if [ -n "$WARP_RUNTIME_DETAILS" ]; then
    printf '[warp-vps] warp-cli 命令输出：\n%s' "$WARP_RUNTIME_DETAILS" >&2
  fi
  status_output="$(timeout 15 warp-cli --accept-tos status 2>&1 || true)"
  if [ -n "$status_output" ]; then
    printf '[warp-vps] warp-cli status：\n%s\n' "$status_output" >&2
  elif [ -n "$WARP_REGISTRATION_DETAIL" ]; then
    printf '[warp-vps] 注册检查输出：\n%s\n' "$WARP_REGISTRATION_DETAIL" >&2
  fi
}

configure_warp_runtime() {
  command -v warp-cli >/dev/null 2>&1 || {
    warn "找不到 warp-cli"
    return 1
  }
  systemctl enable warp-svc.service >/dev/null 2>&1 || {
    warn "无法启用 warp-svc.service"
    return 1
  }
  systemctl start warp-svc.service >/dev/null 2>&1 || {
    warn "无法启动 warp-svc.service"
    return 1
  }

  WARP_RUNTIME_DETAILS=""
  inspect_warp_registration
  if [ "$WARP_REGISTRATION_STATE" = "missing" ]; then
    log "Cloudflare WARP 尚未注册，正在创建注册"
    create_warp_registration || true
  fi

  try_warp_command "mode proxy" --accept-tos mode proxy \
    || try_warp_command "mode proxy" mode proxy \
    || true
  try_warp_command "tunnel protocol set MASQUE" --accept-tos tunnel protocol set MASQUE \
    || try_warp_command "tunnel protocol set MASQUE" tunnel protocol set MASQUE \
    || true
  try_warp_command "proxy port ${WARP_SOCKS_PORT}" --accept-tos proxy port "$WARP_SOCKS_PORT" \
    || try_warp_command "proxy port ${WARP_SOCKS_PORT}" proxy port "$WARP_SOCKS_PORT" \
    || true

  local attempt
  for ((attempt = 1; attempt <= 3; attempt++)); do
    try_warp_command "connect" --accept-tos connect \
      || try_warp_command "connect" connect \
      || true
    warp_proxy_local_ready && break
    sleep 2
  done

  if wait_for_warp_proxy_ready 90; then
    return 0
  fi
  print_warp_diagnostics
  return 1
}

test_quiet() {
  load_config
  if [ "$WARP_MODE" = "wireguard" ]; then
    wg_interface_is_wireguard || return 1
    socks_table_absent
    return
  fi
  wait_for_socks_listen 8 || return 1
  redsocks_local_ready || return 1
  table_exists || return 1
  socks_wireguard_routes_absent
}

print_rule_summary() {
  section "规则快照"
  if [ ! -r "${RULES_DIR}/rules.meta.json" ]; then
    warn_line "找不到规则快照：${RULES_DIR}/rules.meta.json"
    return 1
  fi
  python3 - "${RULES_DIR}/rules.meta.json" <<'PY' | while IFS= read -r line; do
import json
import pathlib
import sys

meta = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
source = meta.get("source", {})
print(f"Google 官方发布时间：{source.get('goog_creation_time', '未知')}")
print(f"本地规则生成时间：{meta.get('generated_at', '未知')}")
print(f"IPv4 规则数量：{meta.get('ipv4_count', '未知')}")
print(f"IPv6 规则数量：{meta.get('ipv6_count', '未知')}")
PY
    info_line "$line"
  done
}

curl_unlock_page() {
  local url="$1"
  curl -4 -fsSL --connect-timeout "$UNLOCK_CONNECT_TIMEOUT" --max-time "$UNLOCK_MAX_TIME" \
    -A "$UNLOCK_TEST_UA" \
    -H 'accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8' \
    -H 'accept-language: en-US,en;q=0.9' \
    "$url" 2>/dev/null || true
}

curl_gemini_location() {
  curl -4 -fsSL --connect-timeout "$UNLOCK_CONNECT_TIMEOUT" --max-time "$UNLOCK_MAX_TIME" \
    -A "$UNLOCK_TEST_UA" \
    -H 'accept-language: en-US' \
    --data-raw 'f.req=[[["K4WWud","[[0],[\"en-US\"]]",null,"generic"]]]' \
    'https://gemini.google.com/_/BardChatUi/data/batchexecute' 2>/dev/null || true
}

extract_youtube_region() {
  local body="$1"
  python3 -c '
import re
import sys

body = sys.stdin.read()
for key in ("INNERTUBE_CONTEXT_GL", "contentRegion", "countryCode"):
    pattern = rf"\"{key}\"\s*:\s*\"([A-Za-z]{{2}})\""
    values = []
    for value in re.findall(pattern, body):
        value = value.upper()
        if value not in values:
            values.append(value)
    if len(values) == 1:
        print(values[0])
        raise SystemExit(0)
    if len(values) > 1:
        raise SystemExit(2)
raise SystemExit(1)
' <<< "$body"
}

parse_gemini_location() {
  local response="$1"
  [ -n "$response" ] || return 1
  python3 -c '
import json
import sys

raw = sys.stdin.read()
start = raw.find("[")
if start < 0:
    raise SystemExit(1)
try:
    outer, _ = json.JSONDecoder().raw_decode(raw[start:])
except (json.JSONDecodeError, TypeError):
    raise SystemExit(1)
if not isinstance(outer, list):
    raise SystemExit(1)
for row in outer:
    if not isinstance(row, list) or len(row) < 3:
        continue
    if row[0] != "wrb.fr" or row[1] != "K4WWud" or not isinstance(row[2], str):
        continue
    try:
        inner = json.loads(row[2])
    except (json.JSONDecodeError, IndexError, TypeError):
        raise SystemExit(1)
    if not isinstance(inner, list) or not inner or not isinstance(inner[0], list) or not inner[0]:
        raise SystemExit(1)
    location = inner[0][0]
    if not isinstance(location, str):
        raise SystemExit(1)
    location = location.strip()
    if len(location) < 3 or len(location) > 160 or "|" in location or any(ord(ch) < 32 for ch in location):
        raise SystemExit(1)
    print(location)
    raise SystemExit(0)
raise SystemExit(1)
' <<< "$response"
}

mainland_china_location() {
  local location
  location="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$location" in
    *hong\ kong*|*macao*|*macau*|*taiwan*) return 1 ;;
    china|*,\ china|*mainland\ china*|*people\'s\ republic\ of\ china*|prc|*,\ prc|*中国大陆*|中国) return 0 ;;
    *) return 1 ;;
  esac
}

gemini_page_normal() {
  local body="$1"
  grep -Fq '<base href="https://gemini.google.com/">' <<< "$body" \
    && grep -Eq 'BardChatUi|property="og:site_name" content="Gemini"' <<< "$body"
}

evaluate_gemini_unlock() {
  local body="$1"
  local location_response="$2"
  local location
  local restricted=0

  if grep -Eiq "gemini (is not|isn.t)( currently)? available in your (country|region)|not( currently)? available in your (country|region)|unavailable in your (country|region)" <<< "$body"; then
    restricted=1
  fi
  if [ "$restricted" -eq 1 ] && gemini_page_normal "$body"; then
    printf 'unknown|页面特征冲突\n'
    return 0
  fi
  if [ "$restricted" -eq 1 ]; then
    printf 'no|当前出口地区受限\n'
    return 0
  fi
  if [ -z "$body" ] || [ -z "$location_response" ]; then
    printf 'unknown|请求失败或未返回完整响应\n'
    return 0
  fi
  location="$(parse_gemini_location "$location_response" 2>/dev/null || true)"
  if [ -z "$location" ]; then
    printf 'unknown|位置响应无法解析\n'
    return 0
  fi
  if mainland_china_location "$location"; then
    printf 'no|位置：%s；个人版不可用，Workspace 账号例外\n' "$location"
    return 0
  fi
  if ! gemini_page_normal "$body"; then
    printf 'unknown|页面特征不明确\n'
    return 0
  fi
  printf 'yes|位置：%s\n' "$location"
}

probe_gemini_unlock() {
  local body location_response
  body="$(curl_unlock_page "https://gemini.google.com/")"
  location_response="$(curl_gemini_location)"
  evaluate_gemini_unlock "$body" "$location_response"
}

evaluate_youtube_premium_unlock() {
  local body="$1"
  local region=""
  local region_status=0
  local unavailable=0
  local available=0

  if [ -z "$body" ]; then
    printf 'unknown|网络连接失败\n'
    return 0
  fi

  if region="$(extract_youtube_region "$body" 2>/dev/null)"; then
    :
  else
    region_status=$?
  fi

  if grep -Fqi 'Premium is not available in your country' <<< "$body"; then
    unavailable=1
  fi
  if grep -Eiq 'ad-free|purchaseButtonOverride|Start trial' <<< "$body"; then
    available=1
  fi

  if [ "$unavailable" -eq 1 ]; then
    if [ -n "$region" ]; then
      printf 'no|地区：%s\n' "$region"
    else
      printf 'no|当前出口不可用\n'
    fi
    return 0
  fi

  if [ "$region_status" -eq 2 ]; then
    printf 'unknown|地区信息冲突\n'
    return 0
  fi

  if [ "$region" = "CN" ]; then
    printf 'no|地区：CN\n'
    return 0
  fi

  if [ -n "$region" ] && [ "$available" -eq 1 ]; then
    printf 'yes|地区：%s\n' "$region"
    return 0
  fi

  if [ -z "$region" ]; then
    printf 'unknown|未取到地区\n'
  else
    printf 'unknown|页面特征不明确\n'
  fi
}

probe_youtube_premium_unlock() {
  local body
  body="$(curl_unlock_page "https://www.youtube.com/premium")"
  evaluate_youtube_premium_unlock "$body"
}

print_unlock_result() {
  local name="$1"
  local result="$2"
  local status detail suffix
  status="${result%%|*}"
  detail="${result#*|}"
  [ "$detail" != "$result" ] || detail=""
  suffix=""
  [ -n "$detail" ] && suffix="（${detail}）"
  case "$status" in
    yes) ok_line "${name}：可用${suffix}" ;;
    no) warn_line "${name}：不可用${suffix}" ;;
    *) warn_line "${name}：无法确认${suffix}" ;;
  esac
}

run_unlock_checks() {
  section "服务解锁检测（IPv4）"
  if ! command -v curl >/dev/null 2>&1; then
    warn_line "找不到 curl，无法检测 Gemini 和 YouTube Premium"
    return 0
  fi
  info_line "正在检测 Gemini 和 YouTube Premium，请稍等"
  print_unlock_result "Gemini" "$(probe_gemini_unlock)"
  print_unlock_result "YouTube Premium" "$(probe_youtube_premium_unlock)"
  info_line "检测基于公开网页特征和本机 IPv4 出口；若 Google 页面或地区策略变化，可能显示无法确认。"
}

google_http_probe() {
  local family="$1"
  curl "$family" -sS --connect-timeout 5 --max-time 12 -o /dev/null \
    https://www.google.com/generate_204 >/dev/null 2>&1
}

run_external_diagnostics() {
  section "外部连通性诊断（仅供参考）"
  if ! command -v curl >/dev/null 2>&1; then
    warn_line "找不到 curl，无法执行外部连通性诊断"
    return 0
  fi

  if [ "$WARP_MODE" = "wireguard" ]; then
    if google_http_probe -4; then
      ok_line "Google IPv4 已返回 HTTP 响应"
    else
      warn_line "Google IPv4 暂时无法确认；不影响本地运行状态"
    fi
    if google_http_probe -6; then
      ok_line "Google IPv6 已返回 HTTP 响应"
    else
      warn_line "Google IPv6 暂时无法确认；不影响本地运行状态"
    fi
    if wg_handshake_recent; then
      ok_line "WireGuard 最近有握手"
    else
      info_line "WireGuard 握手暂时无法确认"
    fi
    return 0
  fi

  if socks_ok; then
    ok_line "Cloudflare WARP SOCKS 外部出口已确认"
  else
    warn_line "Cloudflare WARP SOCKS 外部出口暂时无法确认；不影响本地运行状态"
  fi

  local before after
  before="$(google_counter || true)"
  if google_http_probe -4; then
    after="$(google_counter || true)"
    if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -gt "$before" ]; then
      ok_line "Google IPv4 测试请求命中 SOCKS 分流规则"
    else
      warn_line "Google IPv4 已返回 HTTP 响应，但暂时无法确认计数器变化"
    fi
  else
    warn_line "Google IPv4 暂时无法确认；不影响本地运行状态"
  fi
  return 0
}

run_self_check() {
  local failed=0

  section "本地状态自检"
  if [ "$WARP_MODE" = "wireguard" ]; then
    info_line "当前模式：WireGuard"
    if [ "$WARP_SCOPE" = "global" ]; then
      info_line "路由范围：IPv4 / IPv6 全局走 WARP"
    else
      info_line "路由范围：精准分流 Google 服务"
    fi
    info_line "WireGuard 网卡：${WG_IFACE}"

    if unit_ready "wg-quick@${WG_IFACE}.service"; then
      ok_line "WireGuard 开机服务正常"
    else
      fail_line "WireGuard 开机服务异常"
      failed=1
    fi

    if unit_ready warp-vps.service; then
      ok_line "分流规则服务正常"
    else
      fail_line "分流规则服务异常"
      failed=1
    fi

    if unit_ready warp-vps-health.timer; then
      ok_line "自动健康检查已启用"
    else
      info_line "自动健康检查未启用；不影响当前分流"
    fi

    if wg_interface_is_wireguard; then
      ok_line "WireGuard 网卡身份和本地状态正常"
    else
      fail_line "项目同名网卡不存在或不是 WireGuard"
      failed=1
    fi

    if socks_table_absent; then
      ok_line "未发现旧 Socks5 nftables 分流规则"
    else
      fail_line "旧 Socks5 nftables 分流规则仍在生效，或状态无法读取"
      failed=1
    fi

    section "结论"
    if [ "$failed" -eq 0 ]; then
      ok_line "WireGuard 服务、网卡和分流服务正常。可运行 warp-vps test 查看非阻塞外部诊断。"
      return 0
    fi
    fail_line "当前异常。请先运行：warp-vps restart"
    warn_line "如果重启后仍失败，请运行：warp-vps logs"
    return 1
  fi

  info_line "当前模式：Socks5 兼容模式"
  if [ "$WARP_SCOPE" = "global" ]; then
    info_line "路由范围：VPS 主动发起的公网 IPv4 TCP 全局走 WARP"
  else
    info_line "路由范围：精准分流 Google 服务"
  fi
  info_line "WARP SOCKS 端口：${WARP_SOCKS_PORT}"
  info_line "本地转发端口：${REDSOCKS_PORT}"

  if unit_ready warp-svc.service; then
    ok_line "WARP 官方客户端服务正常"
  else
    fail_line "WARP 官方客户端服务异常"
    failed=1
  fi

  if unit_ready warp-vps-redsocks.service; then
    ok_line "本地透明转发服务正常"
  else
    fail_line "本地透明转发服务异常"
    failed=1
  fi

  if unit_ready warp-vps.service; then
    ok_line "分流规则服务正常"
  else
    fail_line "分流规则服务异常"
    failed=1
  fi

  if unit_ready warp-vps-health.timer; then
    ok_line "自动健康检查已启用"
  else
    info_line "自动健康检查未启用；不影响当前分流"
  fi

  if wait_for_socks_listen 8; then
    ok_line "WARP 本地 SOCKS 已启动"
  else
    fail_line "WARP 本地 SOCKS 没有监听"
    failed=1
  fi

  if redsocks_local_ready; then
    ok_line "本地透明转发端口由项目服务正常监听"
  else
    fail_line "本地透明转发端口未由项目服务监听"
    failed=1
  fi

  if table_exists; then
    ok_line "系统分流规则已加载"
  else
    fail_line "系统分流规则未加载"
    failed=1
  fi

  if socks_wireguard_routes_absent; then
    ok_line "未发现旧 WireGuard Google 路由或默认路由接管"
  else
    fail_line "旧 WireGuard Google 路由、默认路由仍在生效，或无法读取本地路由状态"
    failed=1
  fi

  section "结论"
  if [ "$failed" -eq 0 ]; then
    ok_line "WARP、透明转发和 nftables 分流服务正常。可运行 warp-vps test 查看非阻塞外部诊断。"
    return 0
  fi

  fail_line "当前异常。请先运行：warp-vps restart"
  warn_line "如果重启后仍失败，请运行：warp-vps logs"
  return 1
}

cmd_test() {
  require_root
  load_config
  local local_rc=0
  run_self_check || local_rc=$?
  run_external_diagnostics || true
  return "$local_rc"
}

cmd_status() {
  require_root
  load_config
  section "当前配置"
  if [ "$WARP_MODE" = "wireguard" ]; then
    if [ "$WARP_SCOPE" = "global" ]; then
      info_line "工作模式：WireGuard，IPv4、IPv6、TCP、UDP 和 QUIC 全局走 WARP"
    else
      info_line "工作模式：WireGuard，Google IPv4、IPv6、TCP、UDP 和 QUIC 精准走 WARP"
    fi
    info_line "WireGuard 网卡：${WG_IFACE}"
  else
    if [ "$WARP_SCOPE" = "global" ]; then
      info_line "工作模式：Socks5，VPS 主动发起的公网 IPv4 TCP 全局走 WARP，入站连接回包保持原生路径；Google IPv4 UDP/443（QUIC）和 Google IPv6 拒绝"
    else
      info_line "工作模式：Socks5，Google IPv4 TCP 精准走 WARP；Google IPv4 UDP/443（QUIC）和 Google IPv6 拒绝"
    fi
    info_line "WARP SOCKS 端口：${WARP_SOCKS_PORT}"
    info_line "本地转发端口：${REDSOCKS_PORT}"
  fi
  info_line "更新地址：$(mask_repo_url "$REPO_RAW_BASE")"
  print_rule_summary || true
  run_self_check
}

cmd_unlock_check() {
  run_unlock_checks
}

cmd_configure_warp() {
  require_root
  load_config
  [ "$WARP_MODE" = "socks" ] || die "当前不是 Socks5 模式"
  configure_warp_runtime || die "Cloudflare WARP SOCKS 配置失败；上方已输出 warp-cli 诊断"
}

cmd_restart() {
  require_root
  load_config
  section "正在重启"
  begin_runtime_maintenance || die "无法暂停健康检查，未执行重启"
  if [ "$WARP_MODE" = "wireguard" ]; then
    info_line "正在检查 WireGuard WARP 网卡并重新加载分流路由，请稍等"
    systemctl enable "wg-quick@${WG_IFACE}.service" warp-vps.service >/dev/null \
      || die "无法启用 WireGuard 项目服务"
    if ! service_active "wg-quick@${WG_IFACE}.service" || ! wg_interface_is_wireguard; then
      restart_wireguard_runtime || die "重启后 WireGuard 本地运行态未就绪"
    fi
    systemctl restart warp-vps.service || die "无法重启分流规则服务"
    finish_runtime_maintenance
    ok_line "重启完成"
    return
  fi

  info_line "正在重启 WARP 和本地分流服务，请稍等"
  systemctl enable warp-svc.service warp-vps-redsocks.service warp-vps.service >/dev/null \
    || die "无法启用 Socks5 项目服务"
  if ! warp_proxy_local_ready; then
    configure_warp_runtime || die "重启后 Cloudflare WARP SOCKS 本地代理未就绪"
  fi
  systemctl restart warp-vps-redsocks.service || die "无法重启本地透明转发服务"
  wait_for_redsocks_ready 8 || die "本地透明转发服务重启后没有正确监听"
  systemctl restart warp-vps.service || die "无法重启分流规则服务"
  finish_runtime_maintenance
  ok_line "重启完成"
}

cmd_setup_wireguard() {
  require_root
  load_config
  [ "$WARP_MODE" = "wireguard" ] || die "当前不是 WireGuard 模式"
  command -v wg >/dev/null 2>&1 || die "找不到 wg，请先安装 wireguard-tools"
  command -v wg-quick >/dev/null 2>&1 || die "找不到 wg-quick，请先安装 wireguard-tools"
  generate_wg_config
  ok_line "WireGuard 配置已准备完成：${WG_CONFIG}"
}

cmd_preflight_wireguard() {
  require_root
  load_config
  [ "$WARP_MODE" = "wireguard" ] || die "当前不是 WireGuard 模式"
  [ -r "$WG_CONFIG" ] || die "找不到 WireGuard 配置：$WG_CONFIG"
  command -v wg-quick >/dev/null 2>&1 || die "找不到 wg-quick，请先安装 wireguard-tools"
  if ! wg_interface_absent; then
    info_line "正在停止上次安装留下的 WireGuard 网卡：$WG_IFACE"
    remove_wireguard_interface \
      || die "无法停止本项目 WireGuard 网卡：$WG_IFACE"
  fi

  local failed
  failed=0
  info_line "正在临时拉起 WireGuard 网卡做路由预检"
  if ! wg-quick up "$WG_CONFIG"; then
    failed=1
  fi
  if [ "$failed" -eq 0 ]; then
    if ! "$SELF_PATH" apply; then
      failed=1
    fi
  fi
  if ! remove_wireguard_interface; then
    failed=1
  fi
  [ "$failed" -eq 0 ] || die "WireGuard 预检失败，未写入开机服务"
  ok_line "WireGuard 预检通过"
}

download_update_asset() {
  local rel="$1"
  local dest="$2"
  local url
  url="$(raw_asset_url "$rel")"
  curl -fsSL --connect-timeout "$DOWNLOAD_CONNECT_TIMEOUT" --max-time "$DOWNLOAD_MAX_TIME" \
    "$url" -o "$dest" || die "下载项目文件失败：${rel}（${url}）"
}

validate_update_stage() {
  local stage="$1"
  bash -n "${stage}/install.sh" || return 1
  bash -n "${stage}/bin/warp-vps" || return 1
  validate_rules_file "${stage}/rules/google_ipv4.txt" 4 || return 1
  validate_rules_file "${stage}/rules/google_ipv6.txt" 6 || return 1
  python3 - "$stage" <<'PY' || return 1
import json
import pathlib
import sys

stage = pathlib.Path(sys.argv[1])
counts = {}
for family in ("ipv4", "ipv6"):
    path = stage / "rules" / f"google_{family}.txt"
    counts[family] = sum(
        1
        for raw in path.read_text(encoding="utf-8").splitlines()
        if raw.strip() and not raw.strip().startswith("#")
    )
meta_path = stage / "rules" / "rules.meta.json"
meta = json.loads(meta_path.read_text(encoding="utf-8"))
if not isinstance(meta, dict):
    raise SystemExit(f"{meta_path}: metadata must be a JSON object")
for family in ("ipv4", "ipv6"):
    key = f"{family}_count"
    value = meta.get(key)
    if type(value) is not int or value != counts[family]:
        raise SystemExit(
            f"{meta_path}: {key}={value!r}, actual={counts[family]}"
        )
PY
  return 0
}

backup_current_installation() {
  local backup="$1"
  install -d -m 0755 "${backup}/bin" "${backup}/rules" "${backup}/missing"
  backup_update_file "${APP_DIR}/install.sh" "${backup}/install.sh" app-install 0755 "$backup" || return 1
  backup_update_file "${APP_DIR}/bin/warp-vps" "${backup}/bin/warp-vps" app-manager 0755 "$backup" || return 1
  backup_update_file "${RULES_DIR}/google_ipv4.txt" "${backup}/rules/google_ipv4.txt" rules-ipv4 0644 "$backup" || return 1
  backup_update_file "${RULES_DIR}/google_ipv6.txt" "${backup}/rules/google_ipv6.txt" rules-ipv6 0644 "$backup" || return 1
  backup_update_file "${RULES_DIR}/rules.meta.json" "${backup}/rules/rules.meta.json" rules-meta 0644 "$backup" || return 1
  backup_update_file "$BIN_PATH" "${backup}/warp-vps" command 0755 "$backup" || return 1
}

backup_update_file() {
  local source="$1"
  local backup="$2"
  local label="$3"
  local mode="$4"
  local backup_root="$5"
  if [ -f "$source" ]; then
    install -m "$mode" "$source" "$backup" || return 1
  else
    : > "${backup_root}/missing/$label" || return 1
  fi
}

activate_update_stage() {
  local stage="$1"
  install -m 0755 "${stage}/install.sh" "${APP_DIR}/install.sh" || return 1
  install -m 0755 "${stage}/bin/warp-vps" "${APP_DIR}/bin/warp-vps" || return 1
  install -m 0644 "${stage}/rules/google_ipv4.txt" "${RULES_DIR}/google_ipv4.txt" || return 1
  install -m 0644 "${stage}/rules/google_ipv6.txt" "${RULES_DIR}/google_ipv6.txt" || return 1
  install -m 0644 "${stage}/rules/rules.meta.json" "${RULES_DIR}/rules.meta.json" || return 1
  install -m 0755 "${APP_DIR}/bin/warp-vps" "$BIN_PATH" || return 1
}

restore_update_backup() {
  local backup="$1"
  install -d -m 0755 "${backup}/failed-new" || return 1
  restore_update_file "${APP_DIR}/install.sh" "${backup}/install.sh" app-install 0755 "$backup" || return 1
  restore_update_file "${APP_DIR}/bin/warp-vps" "${backup}/bin/warp-vps" app-manager 0755 "$backup" || return 1
  restore_update_file "${RULES_DIR}/google_ipv4.txt" "${backup}/rules/google_ipv4.txt" rules-ipv4 0644 "$backup" || return 1
  restore_update_file "${RULES_DIR}/google_ipv6.txt" "${backup}/rules/google_ipv6.txt" rules-ipv6 0644 "$backup" || return 1
  restore_update_file "${RULES_DIR}/rules.meta.json" "${backup}/rules/rules.meta.json" rules-meta 0644 "$backup" || return 1
  restore_update_file "$BIN_PATH" "${backup}/warp-vps" command 0755 "$backup" || return 1
}

restore_update_file() {
  local live="$1"
  local backup_file="$2"
  local label="$3"
  local mode="$4"
  local backup_root="$5"
  if [ -f "$backup_file" ]; then
    install -m "$mode" "$backup_file" "$live" || return 1
  elif [ -f "${backup_root}/missing/$label" ]; then
    if [ -e "$live" ]; then
      mv "$live" "${backup_root}/failed-new/$label" || return 1
    fi
  else
    return 1
  fi
  return 0
}

reload_runtime_after_update() {
  "$BIN_PATH" install-systemd || return 1
  systemctl daemon-reload || return 1
  if [ "$WARP_MODE" = "wireguard" ]; then
    systemctl enable "wg-quick@${WG_IFACE}.service" warp-vps.service >/dev/null || return 1
    if ! service_active "wg-quick@${WG_IFACE}.service" || ! wg_interface_is_wireguard; then
      restart_wireguard_runtime || return 1
    fi
    systemctl start warp-vps.service || return 1
  else
    systemctl enable warp-svc.service warp-vps-redsocks.service warp-vps.service >/dev/null || return 1
    if ! warp_proxy_local_ready; then
      configure_warp_runtime || return 1
    fi
    systemctl restart warp-vps-redsocks.service || return 1
    wait_for_redsocks_ready 8 || return 1
    systemctl start warp-vps.service || return 1
  fi
}

cmd_update() {
  require_root
  load_config
  local stage backup pause_failed=0 recovery_message recovery_ok=0
  stage="${STATE_DIR}/downloads/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  backup="${STATE_DIR}/rollback/$(date -u +%Y%m%dT%H%M%SZ)-$$"
  section "正在更新"
  info_line "正在从 GitHub 同步脚本和固定规则快照"
  install -d -m 0755 "${stage}/bin" "${stage}/rules"
  download_update_asset "install.sh" "${stage}/install.sh"
  download_update_asset "bin/warp-vps" "${stage}/bin/warp-vps"
  download_update_asset "rules/google_ipv4.txt" "${stage}/rules/google_ipv4.txt"
  download_update_asset "rules/google_ipv6.txt" "${stage}/rules/google_ipv6.txt"
  download_update_asset "rules/rules.meta.json" "${stage}/rules/rules.meta.json"
  validate_update_stage "$stage"
  backup_current_installation "$backup" || die "无法备份当前安装，更新已中止"
  begin_runtime_maintenance || die "无法暂停健康检查，更新未修改运行态"
  systemctl stop warp-vps.service >/dev/null 2>&1 || true
  "$BIN_PATH" stop-rules >/dev/null 2>&1 || true
  if service_active warp-vps.service; then
    pause_failed=1
  fi
  if [ "$pause_failed" -eq 1 ]; then
    if systemctl restart warp-vps.service >/dev/null 2>&1 \
      || systemctl start warp-vps.service >/dev/null 2>&1; then
      if service_active warp-vps.service; then
        recovery_ok=1
      fi
    fi
    if [ "$recovery_ok" -eq 1 ]; then
      recovery_message="旧分流规则已恢复"
    else
      recovery_message="旧分流规则运行态也未能确认恢复"
    fi
    die "无法确认旧分流规则已暂停，更新未替换项目文件；${recovery_message}"
  fi
  if ! activate_update_stage "$stage"; then
    warn_line "更新文件激活失败，正在恢复旧文件"
    restore_update_backup "$backup" || die "更新文件激活失败，且无法恢复旧文件"
    if reload_runtime_after_update; then
      finish_runtime_maintenance
      die "更新失败，已恢复旧文件和原运行态"
    fi
    die "更新文件激活失败，旧文件已恢复，但原运行态未能恢复"
  fi
  ok_line "更新文件已写入，正在重新加载运行态"
  if reload_runtime_after_update; then
    finish_runtime_maintenance
    ok_line "更新完成"
    return 0
  fi

  warn_line "更新后运行态重新加载失败，正在恢复旧版本"
  begin_runtime_maintenance || die "更新后运行态重新加载失败，且无法暂停健康检查以恢复旧版本"
  systemctl stop warp-vps.service >/dev/null 2>&1 || true
  "$BIN_PATH" stop-rules >/dev/null 2>&1 || true
  if [ "$WARP_MODE" = "wireguard" ] && ! stop_wg_routes_strict; then
    die "更新后运行态重新加载失败，且无法清除新版 WireGuard 路由；未恢复旧文件"
  fi
  restore_update_backup "$backup" || die "更新后运行态重新加载失败，且无法恢复旧文件"
  if reload_runtime_after_update; then
    finish_runtime_maintenance
    die "更新失败，已恢复旧版本和原运行态"
  fi
  die "更新失败，且恢复旧版本后运行态仍无法重新加载，请运行 warp-vps logs 查看日志"
}

cmd_heal() {
  require_root
  load_config
  local repair_rules=0
  local repair_redsocks=0
  if required_runtime_units_ready && test_quiet; then
    log "健康检查正常"
    return 0
  fi
  warn "健康检查失败，正在尝试自动修复"
  if [ "$WARP_MODE" = "wireguard" ]; then
    systemctl enable "wg-quick@${WG_IFACE}.service" warp-vps.service >/dev/null \
      || die "无法启用 WireGuard 项目服务"
    if ! socks_table_absent; then
      repair_rules=1
    fi
    if ! service_active "wg-quick@${WG_IFACE}.service" || ! wg_interface_is_wireguard; then
      restart_wireguard_runtime || true
    fi
    if ! service_active warp-vps.service; then
      repair_rules=1
    fi
    if [ "$repair_rules" -eq 1 ]; then
      systemctl restart warp-vps.service >/dev/null 2>&1 || true
    fi
    if required_runtime_units_ready && test_quiet; then
      log "自动修复成功"
    else
      die "自动修复失败，请运行 warp-vps logs 查看日志"
    fi
    return 0
  fi
  if ! socks_wireguard_routes_absent; then
    clear_socks_wireguard_routes || true
  fi
  systemctl enable warp-svc.service warp-vps-redsocks.service warp-vps.service >/dev/null \
    || die "无法启用 Socks5 项目服务"
  if ! warp_proxy_local_ready; then
    configure_warp_runtime || die "自动修复后 Cloudflare WARP SOCKS 仍不可用"
  fi
  if ! service_active warp-vps.service || ! table_exists; then
    repair_rules=1
  fi
  if ! redsocks_local_ready; then
    repair_redsocks=1
  fi
  if [ "$repair_redsocks" -eq 1 ]; then
    render_redsocks_conf
    systemctl restart warp-vps-redsocks.service || die "无法重启本地透明转发服务"
    wait_for_redsocks_ready 8 \
      || die "本地透明转发服务重启后没有正确监听，未重新加载分流规则"
  fi
  if [ "$repair_rules" -eq 1 ]; then
    systemctl restart warp-vps.service || die "无法重启分流规则服务"
  fi
  if required_runtime_units_ready && test_quiet; then
    log "自动修复成功"
  else
    die "自动修复失败，请运行 warp-vps logs 查看日志"
  fi
}

cmd_wait_wireguard() {
  require_root
  load_config
  [ "$WARP_MODE" = "wireguard" ] || die "当前不是 WireGuard 模式"
  wait_for_wg_ready 20
}

cmd_logs() {
  require_root
  load_uninstall_config
  journalctl -u warp-svc -u "wg-quick@${WG_IFACE}.service" -u warp-vps-redsocks.service -u warp-vps.service -u warp-vps-health.service --no-pager -n 200
}

remove_file_if_exists() {
  local path="$1"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  rm -f -- "$path" || die "无法永久删除文件：$path"
  if [ -e "$path" ] || [ -L "$path" ]; then
    die "无法永久删除文件：$path"
  fi
}

remove_tree_if_exists() {
  local path="$1"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  rm -rf -- "$path" || die "无法永久删除目录：$path"
  if [ -e "$path" ] || [ -L "$path" ]; then
    die "无法永久删除目录：$path"
  fi
}

print_remove_target_if_exists() {
  local path="$1"
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  info_line "$path"
}

managed_swap_listed_in() {
  local state_file="$1"
  local rc=0
  [ -r "$state_file" ] || die "无法读取 Swap 状态文件：$state_file"
  awk -v swap_file="$MANAGED_SWAP_FILE" '
    $1 == swap_file { found=1 }
    END { exit !found }
  ' "$state_file" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "无法解析 Swap 状态文件：$state_file" ;;
  esac
}

uninstall_managed_swap() {
  local fstab_tmp
  if managed_swap_listed_in /proc/swaps; then
    info_line "正在停用本脚本创建的 Swap：$MANAGED_SWAP_FILE"
    swapoff "$MANAGED_SWAP_FILE" || die "无法停用本脚本创建的 Swap：$MANAGED_SWAP_FILE"
    if managed_swap_listed_in /proc/swaps; then
      die "本脚本创建的 Swap 仍在使用，拒绝永久删除：$MANAGED_SWAP_FILE"
    fi
  fi
  if managed_swap_listed_in /etc/fstab; then
    info_line "正在从 /etc/fstab 移除本脚本创建的 Swap 记录"
    fstab_tmp="$(mktemp /run/warp-vps-fstab.XXXXXX)" \
      || die "无法创建 /etc/fstab 临时文件"
    if ! awk -v swap_file="$MANAGED_SWAP_FILE" '$1 != swap_file { print }' /etc/fstab > "$fstab_tmp"; then
      rm -f -- "$fstab_tmp" || die "无法删除 /etc/fstab 临时文件：$fstab_tmp"
      die "无法生成新的 /etc/fstab"
    fi
    if ! install -m 0644 "$fstab_tmp" /etc/fstab; then
      rm -f -- "$fstab_tmp" || die "无法删除 /etc/fstab 临时文件：$fstab_tmp"
      die "无法更新 /etc/fstab"
    fi
    rm -f -- "$fstab_tmp" || die "无法删除 /etc/fstab 临时文件：$fstab_tmp"
    if managed_swap_listed_in /etc/fstab; then
      die "/etc/fstab 仍包含本脚本创建的 Swap 记录，拒绝永久删除：$MANAGED_SWAP_FILE"
    fi
  fi
  remove_file_if_exists "$MANAGED_SWAP_FILE"
}

disable_managed_warp_service() {
  [ "${MANAGED_WARP_SVC:-0}" = "1" ] || return 0
  info_line "正在停止 Cloudflare WARP 官方客户端服务"
  systemctl stop warp-svc.service >/dev/null 2>&1 || true
  systemctl disable warp-svc.service >/dev/null 2>&1 || true
}

ensure_wireguard_down_for_uninstall() {
  uninstall_wg_interface_exists || return 0
  UNINSTALL_WIREGUARD_PRESENT=1
  info_line "正在关闭 WireGuard 网卡：${WG_IFACE:-$DEFAULT_WG_IFACE}"
  if command -v wg-quick >/dev/null 2>&1 && [ -r "${WG_CONFIG:-$DEFAULT_WG_CONFIG}" ]; then
    wg-quick down "${WG_CONFIG:-$DEFAULT_WG_CONFIG}" >/dev/null 2>&1 \
      || wg-quick down "${WG_IFACE:-$DEFAULT_WG_IFACE}" >/dev/null 2>&1 \
      || true
  fi
  if uninstall_wg_interface_exists; then
    ip link delete dev "${WG_IFACE:-$DEFAULT_WG_IFACE}" >/dev/null 2>&1 || true
  fi
  if uninstall_wg_interface_exists; then
    die "WireGuard 网卡仍在运行，卸载已中止：${WG_IFACE:-$DEFAULT_WG_IFACE}"
  fi
}

managed_redsocks_fallback_exists() {
  local marker_value
  [ -x "$REDSOCKS_FALLBACK_BIN" ] || return 1
  [ -r "${STATE_DIR}/managed-redsocks-fallback" ] || return 1
  marker_value="$(head -n 1 "${STATE_DIR}/managed-redsocks-fallback" 2>/dev/null || true)"
  [ "$marker_value" = "$REDSOCKS_MANAGED_VERSION" ] || return 1
  grep -aFq "$REDSOCKS_MANAGED_VERSION" "$REDSOCKS_FALLBACK_BIN" 2>/dev/null
}

managed_wireguard_config_owned() {
  [ -f "$WG_CONFIG" ] || return 1
  [ -r "$WG_CONFIG" ] || return 1
  [ -f "$WGCF_ACCOUNT" ] || return 1
  [ -r "$WGCF_ACCOUNT" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$WGCF_ACCOUNT" "$WG_CONFIG" <<'PY'
import hmac
import pathlib
import re
import sys

try:
    account = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
    profile = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8")
except (OSError, UnicodeError):
    raise SystemExit(1)

account_matches = re.findall(
    r"""(?m)^[ \t]*private_key[ \t]*=[ \t]*(?:"([^"\r\n]+)"|'([^'\r\n]+)')[ \t]*(?:#.*)?$""",
    account,
)
profile_matches = re.findall(
    r"(?mi)^[ \t]*PrivateKey[ \t]*=[ \t]*([^# \t\r\n]+)[ \t]*(?:#.*)?$",
    profile,
)
if len(account_matches) != 1 or len(profile_matches) != 1:
    raise SystemExit(1)

account_key = account_matches[0][0] or account_matches[0][1]
raise SystemExit(0 if hmac.compare_digest(account_key, profile_matches[0]) else 1)
PY
}

wireguard_config_in_project_tree() {
  command -v python3 >/dev/null 2>&1 || return 2
  python3 - "$WG_CONFIG" "$ETC_DIR" "$APP_DIR" "$STATE_DIR" <<'PY'
import os
import sys

try:
    path = os.path.abspath(sys.argv[1])
    real_path = os.path.realpath(path)
    for raw_root in sys.argv[2:]:
        root = os.path.abspath(raw_root)
        real_root = os.path.realpath(root)
        if (
            os.path.commonpath((path, root)) == root
            or os.path.commonpath((real_path, real_root)) == real_root
        ):
            raise SystemExit(0)
except (OSError, ValueError):
    raise SystemExit(2)
raise SystemExit(1)
PY
}

prompt_uninstall_scope() {
  local choice
  while true; do
    printf '\n卸载会永久删除项目文件。是否一并卸载相关运行依赖？\n' >&2
    printf '  1. 保留依赖，只卸载 WARP VPS Manager（默认）\n' >&2
    printf '  2. 一并卸载 Cloudflare WARP、redsocks 和 wireguard-tools\n' >&2
    printf '请输入选项 [1]：' >&2
    read_input choice \
      || die "无法读取输入；非交互式卸载请使用 warp-vps uninstall --yes 或 warp-vps uninstall all"
    case "$choice" in
      ''|1)
        UNINSTALL_REMOVE_DEPENDENCIES=0
        return 0
        ;;
      2)
        UNINSTALL_REMOVE_DEPENDENCIES=1
        return 0
        ;;
      *) printf '输入无效，请输入 1 或 2。\n' >&2 ;;
    esac
  done
}

resolve_uninstall_scope() {
  if [ "$#" -gt 1 ]; then
    printf '[warp-vps] 错误：uninstall 只接受一个选项：--yes 或 all\n' >&2
    return 2
  fi
  case "${1:-}" in
    '') prompt_uninstall_scope ;;
    --yes) UNINSTALL_REMOVE_DEPENDENCIES=0 ;;
    all) UNINSTALL_REMOVE_DEPENDENCIES=1 ;;
    *)
      printf '[warp-vps] 错误：未知卸载选项：%s（可用：--yes、all）\n' "$1" >&2
      return 2
      ;;
  esac
}

uninstall_unit_is_active() {
  local unit="$1"
  local state_output load_state active_state
  state_output="$(systemctl show "$unit" -p LoadState -p ActiveState --no-pager 2>/dev/null)" \
    || die "无法查询 systemd 服务状态：$unit"
  load_state="$(awk -F= '$1 == "LoadState" { print substr($0, index($0, "=") + 1); exit }' <<< "$state_output")"
  [ "$load_state" != "not-found" ] || return 1
  [ -n "$load_state" ] || die "systemd 没有返回服务加载状态：$unit"
  active_state="$(awk -F= '$1 == "ActiveState" { print substr($0, index($0, "=") + 1); exit }' <<< "$state_output")"
  case "$active_state" in
    inactive|failed) return 1 ;;
    active|activating|deactivating|reloading) return 0 ;;
    *) die "无法识别 systemd 服务运行状态：$unit=$active_state" ;;
  esac
}

uninstall_unit_is_enabled() {
  local unit="$1"
  local state_output load_state unit_state rc
  state_output="$(systemctl show "$unit" -p LoadState --no-pager 2>/dev/null)" \
    || die "无法查询 systemd 服务加载状态：$unit"
  load_state="$(awk -F= '$1 == "LoadState" { print substr($0, index($0, "=") + 1); exit }' <<< "$state_output")"
  [ "$load_state" != "not-found" ] || return 1
  [ -n "$load_state" ] || die "systemd 没有返回服务加载状态：$unit"
  rc=0
  unit_state="$(systemctl is-enabled "$unit" 2>/dev/null)" || rc=$?
  case "$unit_state" in
    enabled|enabled-runtime) return 0 ;;
    disabled|masked|masked-runtime|not-found|linked|linked-runtime|alias|static|indirect|generated|transient) return 1 ;;
    *) die "无法确认 systemd 服务是否已禁用：${unit}（状态：${unit_state:-无}，退出码：${rc}）" ;;
  esac
}

verify_project_units_for_uninstall() {
  local unit
  local wg_unit="wg-quick@${WG_IFACE}.service"
  local -a stop_units=(
    warp-vps-health.timer
    warp-vps-health.service
    warp-vps.service
    warp-vps-redsocks.service
    "$wg_unit"
  )
  local -a enabled_units=(
    warp-vps-health.timer
    warp-vps.service
    warp-vps-redsocks.service
    "$wg_unit"
  )
  for unit in "${stop_units[@]}"; do
    if uninstall_unit_is_active "$unit"; then
      die "系统服务仍在运行，无法保证分流停止：$unit"
    fi
  done
  for unit in "${enabled_units[@]}"; do
    if uninstall_unit_is_enabled "$unit"; then
      die "系统服务仍会开机启动，卸载已中止：$unit"
    fi
  done
}

stop_project_units_for_uninstall() {
  local unit
  local wg_unit="wg-quick@${WG_IFACE}.service"
  systemctl stop warp-vps-health.timer >/dev/null 2>&1 || true
  systemctl stop warp-vps-health.service >/dev/null 2>&1 || true
  systemctl stop warp-vps-health.timer >/dev/null 2>&1 || true
  systemctl disable warp-vps-health.timer >/dev/null 2>&1 || true
  if uninstall_unit_is_active warp-vps-health.timer; then
    die "健康检查定时器仍在运行，卸载已中止：warp-vps-health.timer"
  fi
  if uninstall_unit_is_active warp-vps-health.service; then
    die "健康检查仍在运行，卸载已中止：warp-vps-health.service"
  fi
  if uninstall_unit_is_enabled warp-vps-health.timer; then
    die "健康检查定时器仍会开机启动，卸载已中止：warp-vps-health.timer"
  fi
  systemctl stop warp-vps.service >/dev/null 2>&1 || true
  systemctl disable warp-vps.service >/dev/null 2>&1 || true
  # Either mode-specific backend unit may be absent; keep their operations independent.
  for unit in warp-vps-redsocks.service "$wg_unit"; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl disable "$unit" >/dev/null 2>&1 || true
  done
  verify_project_units_for_uninstall
}

deactivate_runtime_for_uninstall() {
  local ip_available
  command -v systemctl >/dev/null 2>&1 || die "找不到 systemctl，无法停止项目服务"
  stop_project_units_for_uninstall || die "无法停止并禁用项目服务"

  ip_available=0
  if command -v ip >/dev/null 2>&1; then
    ip_available=1
    if uninstall_wg_interface_exists; then
      UNINSTALL_WIREGUARD_PRESENT=1
      if [ "$UNINSTALL_RUNTIME_IDENTIFIED" -eq 0 ]; then
        UNINSTALL_RUNTIME_IDENTIFIED=1
        WARP_MODE=wireguard
      fi
    fi
  fi
  if command -v nft >/dev/null 2>&1 && uninstall_nft_table_exists; then
    if [ "$UNINSTALL_RUNTIME_IDENTIFIED" -eq 0 ]; then
      UNINSTALL_RUNTIME_IDENTIFIED=1
      WARP_MODE=socks
    fi
  fi
  stop_rules_for_uninstall || die "无法停止本项目分流规则"
  if [ "$ip_available" -eq 1 ]; then
    ensure_wireguard_down_for_uninstall || die "无法关闭本项目 WireGuard 网卡"
  elif [ "$WARP_MODE" = "wireguard" ] || [ "$UNINSTALL_RUNTIME_IDENTIFIED" -eq 0 ]; then
    die "找不到 ip 命令；已停止可识别的服务和 nftables 规则，但无法确认 WireGuard 分流已经失效"
  fi
  disable_managed_warp_service || die "无法停止项目安装的 Cloudflare WARP 服务"

  if command -v nft >/dev/null 2>&1 && uninstall_nft_table_exists; then
    die "本项目 nftables 分流规则仍在生效，卸载已中止"
  fi
  if command -v nft >/dev/null 2>&1 \
    && uninstall_nft_table_exists "$WG_GLOBAL_NFT_TABLE"; then
    die "本项目 WireGuard 全局回包规则仍在生效，卸载已中止"
  fi
  if [ "$ip_available" -eq 1 ] && uninstall_wg_interface_exists; then
    die "本项目 WireGuard 网卡仍在运行，卸载已中止：$WG_IFACE"
  fi
  verify_project_units_for_uninstall
  if [ "${MANAGED_WARP_SVC:-0}" = "1" ] && uninstall_unit_is_active warp-svc.service; then
    die "Cloudflare WARP 官方客户端服务仍在运行，卸载已中止"
  fi
  if [ "${MANAGED_WARP_SVC:-0}" = "1" ] && uninstall_unit_is_enabled warp-svc.service; then
    die "Cloudflare WARP 官方客户端服务仍会开机启动，卸载已中止"
  fi
  if [ "$UNINSTALL_RUNTIME_IDENTIFIED" -eq 0 ]; then
    die "找不到有效的项目配置或分流服务定义，无法排除未知的自定义 WireGuard 网卡；已停止可识别的规则，卸载未继续"
  fi
  ok_line "分流服务、nftables 规则和项目 WireGuard 网卡均已停止"
}

uninstall_apt_dependencies() {
  local package inventory status
  local -a packages=()
  # shellcheck disable=SC2016
  inventory="$(dpkg-query -W -f='${binary:Package}\t${db:Status-Status}\n')" \
    || die "无法读取 dpkg 软件包状态，依赖卸载已中止"
  for package in cloudflare-warp redsocks wireguard-tools; do
    status="$(awk -F '\t' -v package="$package" '
      $1 == package || index($1, package ":") == 1 { print $2; exit }
    ' <<< "$inventory")" \
      || die "无法解析 dpkg 软件包状态，依赖卸载已中止"
    case "$status" in ''|not-installed) ;; *) packages+=("$package") ;; esac
  done
  [ "${#packages[@]}" -gt 0 ] || return 0
  DEBIAN_FRONTEND=noninteractive apt-get \
    -o DPkg::Lock::Timeout=1200 \
    -o APT::Get::AutomaticRemove=false \
    purge -y "${packages[@]}" \
    || die "APT 卸载专用运行依赖失败；项目文件尚未删除，可以修复后重试"
  # shellcheck disable=SC2016
  inventory="$(dpkg-query -W -f='${binary:Package}\t${db:Status-Status}\n')" \
    || die "APT 已执行，但无法复核 dpkg 软件包状态"
  for package in "${packages[@]}"; do
    status="$(awk -F '\t' -v package="$package" '
      $1 == package || index($1, package ":") == 1 { print $2; exit }
    ' <<< "$inventory")" \
      || die "APT 已执行，但无法解析 dpkg 软件包状态"
    case "$status" in
      ''|not-installed) ;;
      *) die "APT 未彻底卸载软件包：${package}（状态：${status}）" ;;
    esac
  done
}

uninstall_rpm_dependencies() {
  local package manager inventory rc
  local -a packages=()
  inventory="$(rpm -qa --qf '%{NAME}\n')" \
    || die "无法读取 RPM 软件包状态，依赖卸载已中止"
  for package in cloudflare-warp redsocks wireguard-tools; do
    rc=0
    grep -Fxq "$package" <<< "$inventory" || rc=$?
    case "$rc" in
      0) packages+=("$package") ;;
      1) ;;
      *) die "无法解析 RPM 软件包状态，依赖卸载已中止" ;;
    esac
  done
  [ "${#packages[@]}" -gt 0 ] || return 0
  if command -v dnf >/dev/null 2>&1; then
    manager=dnf
  elif command -v yum >/dev/null 2>&1; then
    manager=yum
  else
    die "找不到 dnf 或 yum，无法卸载 RPM 专用运行依赖"
  fi
  if [ "$manager" = "dnf" ]; then
    dnf -y --setopt=clean_requirements_on_remove=False remove "${packages[@]}" \
      || die "DNF 卸载专用运行依赖失败；项目文件尚未删除，可以修复后重试"
  else
    yum --setopt=clean_requirements_on_remove=0 remove -y "${packages[@]}" \
      || die "YUM 卸载专用运行依赖失败；项目文件尚未删除，可以修复后重试"
  fi
  inventory="$(rpm -qa --qf '%{NAME}\n')" \
    || die "RPM 卸载已执行，但无法复核软件包状态"
  for package in "${packages[@]}"; do
    rc=0
    grep -Fxq "$package" <<< "$inventory" || rc=$?
    case "$rc" in
      0) die "RPM 未彻底卸载软件包：$package" ;;
      1) ;;
      *) die "RPM 已执行，但无法解析软件包状态" ;;
    esac
  done
}

uninstall_project_dependencies() {
  local unit
  info_line "正在卸载相关运行依赖；不会主动执行 autoremove，共享基础包不在直接卸载清单"
  # Either dependency service may already be absent.
  for unit in warp-svc.service redsocks.service; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl disable "$unit" >/dev/null 2>&1 || true
    if uninstall_unit_is_active "$unit"; then
      die "依赖服务仍在运行，不能安全卸载：$unit"
    fi
  done

  if command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
    uninstall_apt_dependencies
  elif command -v rpm >/dev/null 2>&1; then
    uninstall_rpm_dependencies
  else
    die "找不到受支持的包管理器，无法卸载专用运行依赖"
  fi
}

cmd_uninstall() {
  require_root
  resolve_uninstall_scope "$@" || return $?

  local remove_managed_redsocks remove_wg_config wg_tree_rc
  load_uninstall_config
  recover_uninstall_runtime_from_unit
  remove_managed_redsocks=0
  remove_wg_config=0
  if [ "$UNINSTALL_REMOVE_DEPENDENCIES" -eq 1 ] && managed_redsocks_fallback_exists; then
    remove_managed_redsocks=1
  fi
  if [ "$UNINSTALL_WIREGUARD_PRESENT" -eq 1 ] && managed_wireguard_config_owned; then
    remove_wg_config=1
  fi
  if [ "$UNINSTALL_WIREGUARD_PRESENT" -eq 1 ] && [ "$remove_wg_config" -eq 0 ] \
    && { [ -e "$WG_CONFIG" ] || [ -L "$WG_CONFIG" ]; }; then
    wg_tree_rc=0
    wireguard_config_in_project_tree || wg_tree_rc=$?
    case "$wg_tree_rc" in
      0)
        die "无法确认 WireGuard 配置由本项目创建，且该路径位于将被永久删除的项目目录；请先将文件移到项目目录外并更新 WG_CONFIG：$WG_CONFIG"
        ;;
      1) ;;
      *) die "无法确认 WireGuard 配置是否位于将被永久删除的项目目录：$WG_CONFIG" ;;
    esac
  fi
  deactivate_runtime_for_uninstall || die "无法确认分流规则已经失效，卸载已中止"

  section "永久删除清单"
  info_line "以下项目自有文件会永久删除"
  print_remove_target_if_exists /etc/systemd/system/warp-vps-redsocks.service
  print_remove_target_if_exists /etc/systemd/system/warp-vps.service
  print_remove_target_if_exists /etc/systemd/system/warp-vps-health.service
  print_remove_target_if_exists /etc/systemd/system/warp-vps-health.timer
  print_remove_target_if_exists /etc/systemd/system/multi-user.target.wants/warp-vps-redsocks.service
  print_remove_target_if_exists /etc/systemd/system/multi-user.target.wants/warp-vps.service
  print_remove_target_if_exists /etc/systemd/system/timers.target.wants/warp-vps-health.timer
  print_remove_target_if_exists "/etc/systemd/system/multi-user.target.wants/wg-quick@${WG_IFACE}.service"
  if [ "$remove_wg_config" -eq 1 ]; then
    print_remove_target_if_exists "${WG_CONFIG:-$DEFAULT_WG_CONFIG}"
  elif [ "$UNINSTALL_WIREGUARD_PRESENT" -eq 1 ] \
    && { [ -e "$WG_CONFIG" ] || [ -L "$WG_CONFIG" ]; }; then
    info_line "保留无法确认由本项目创建的 WireGuard 配置：$WG_CONFIG"
  fi
  print_remove_target_if_exists "$ETC_DIR"
  print_remove_target_if_exists "$APP_DIR"
  print_remove_target_if_exists "$STATE_DIR"
  print_remove_target_if_exists "$BIN_PATH"
  if [ "$remove_managed_redsocks" -eq 1 ]; then
    print_remove_target_if_exists "$REDSOCKS_FALLBACK_BIN"
  fi
  print_remove_target_if_exists "$MANAGED_SWAP_FILE"

  if [ "$UNINSTALL_REMOVE_DEPENDENCIES" -eq 1 ]; then
    uninstall_project_dependencies \
      || die "专用运行依赖卸载失败；分流已停止，项目文件尚未删除，可以修复后重试"
    if [ "$remove_managed_redsocks" -eq 1 ]; then
      remove_file_if_exists "$REDSOCKS_FALLBACK_BIN"
    fi
  fi

  uninstall_managed_swap
  remove_file_if_exists /etc/systemd/system/warp-vps-redsocks.service
  remove_file_if_exists /etc/systemd/system/warp-vps.service
  remove_file_if_exists /etc/systemd/system/warp-vps-health.service
  remove_file_if_exists /etc/systemd/system/warp-vps-health.timer
  remove_file_if_exists /etc/systemd/system/multi-user.target.wants/warp-vps-redsocks.service
  remove_file_if_exists /etc/systemd/system/multi-user.target.wants/warp-vps.service
  remove_file_if_exists /etc/systemd/system/timers.target.wants/warp-vps-health.timer
  remove_file_if_exists "/etc/systemd/system/multi-user.target.wants/wg-quick@${WG_IFACE}.service"
  if [ "$remove_wg_config" -eq 1 ]; then
    remove_file_if_exists "${WG_CONFIG:-$DEFAULT_WG_CONFIG}"
  fi
  remove_tree_if_exists "$ETC_DIR"
  remove_tree_if_exists "$APP_DIR"
  remove_tree_if_exists "$STATE_DIR"
  remove_file_if_exists "$BIN_PATH"
  systemctl daemon-reload || die "systemd 重新加载失败；分流已停止，请检查残留文件"
  printf 'WARP VPS Manager 已卸载，项目文件已永久删除。\n'
  if [ "$UNINSTALL_REMOVE_DEPENDENCIES" -eq 1 ]; then
    printf 'Cloudflare WARP、redsocks 和 wireguard-tools 等专用运行依赖已卸载。\n'
  else
    printf '系统依赖包已保留。\n'
  fi
}

usage() {
  cat <<'EOF'
用法：warp-vps [命令]

常用命令：
  menu            打开交互式管理菜单；直接运行 warp-vps 效果相同
  status          快速检查本地运行态
  test            检查本地运行态并运行非阻塞外部诊断
  restart         重启 WARP 分流链路
  unlock-check    只检测当前 IPv4 出口的 Gemini / YouTube Premium
  update          更新脚本和固定规则快照
  reinstall       非交互重装并保持当前模式
  reinstall [安装选项]
                  非交互重装；支持 --mode、--scope、--swap、--socks-port
  switch wireguard|socks [安装选项]
                  非交互切换模式；复用同一安装事务
  logs            查看最近日志
  uninstall       交互永久删除项目，并询问是否一并卸载相关运行依赖
  uninstall --yes 非交互永久删除项目，保留依赖
  uninstall all   非交互永久删除项目及 Cloudflare WARP、redsocks、wireguard-tools

内部命令：
  heal            健康检查和自动修复
  apply           重新生成并加载分流规则
  stop-rules      移除本项目 nftables 规则
  configure-warp  配置并连接 Cloudflare WARP 本地代理
  setup-wireguard 准备 WireGuard WARP 配置
  preflight-wireguard 预检 WireGuard 网卡和路由
  wait-wireguard  等待 WireGuard 出口就绪
  install-systemd 安装 systemd 服务
EOF
}

cli_error() {
  printf '[warp-vps] 错误：%s\n' "$*" >&2
  usage >&2
  return 2
}

interactive_terminal_available() {
  [ -t 0 ] || [ -t 1 ] || [ -t 2 ]
}

cmd_menu() {
  interactive_terminal_available \
    || { cli_error "管理菜单需要交互终端；请使用显式命令"; return 2; }
  require_root
  [ -x "${APP_DIR}/install.sh" ] \
    || die "找不到管理菜单：${APP_DIR}/install.sh；请重新运行安装命令修复项目文件"
  exec "${APP_DIR}/install.sh" --menu
}

cmd_reinstall() {
  require_root
  [ -x "${APP_DIR}/install.sh" ] \
    || die "找不到安装器：${APP_DIR}/install.sh；请重新运行安装命令修复项目文件"
  exec "${APP_DIR}/install.sh" --install --non-interactive "$@"
}

cmd_switch() {
  local mode
  [ "$#" -ge 1 ] \
    || { cli_error "switch 缺少目标模式：wireguard 或 socks"; return 2; }
  mode="$1"
  shift
  case "$mode" in
    wireguard|socks) ;;
    *) cli_error "switch 只接受 wireguard 或 socks"; return 2 ;;
  esac
  cmd_reinstall --mode "$mode" "$@"
}

main() {
  local cmd="${1:-}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    menu) [ "$#" -eq 0 ] || { cli_error "menu 不接受参数"; return 2; }; cmd_menu ;;
    status) [ "$#" -eq 0 ] || { cli_error "status 不接受参数"; return 2; }; cmd_status ;;
    test) [ "$#" -eq 0 ] || { cli_error "test 不接受参数"; return 2; }; cmd_test ;;
    unlock-check) [ "$#" -eq 0 ] || { cli_error "unlock-check 不接受参数"; return 2; }; cmd_unlock_check ;;
    restart) [ "$#" -eq 0 ] || { cli_error "restart 不接受参数"; return 2; }; run_with_runtime_lock wait cmd_restart ;;
    update) [ "$#" -eq 0 ] || { cli_error "update 不接受参数"; return 2; }; run_with_runtime_lock wait cmd_update ;;
    reinstall) cmd_reinstall "$@" ;;
    switch) cmd_switch "$@" ;;
    logs) [ "$#" -eq 0 ] || { cli_error "logs 不接受参数"; return 2; }; cmd_logs ;;
    heal) [ "$#" -eq 0 ] || { cli_error "heal 不接受参数"; return 2; }; run_with_runtime_lock skip cmd_heal ;;
    apply) [ "$#" -eq 0 ] || { cli_error "apply 不接受参数"; return 2; }; require_root; apply_rules ;;
    stop-rules) [ "$#" -eq 0 ] || { cli_error "stop-rules 不接受参数"; return 2; }; require_root; stop_rules ;;
    configure-warp) [ "$#" -eq 0 ] || { cli_error "configure-warp 不接受参数"; return 2; }; cmd_configure_warp ;;
    setup-wireguard) [ "$#" -eq 0 ] || { cli_error "setup-wireguard 不接受参数"; return 2; }; cmd_setup_wireguard ;;
    preflight-wireguard) [ "$#" -eq 0 ] || { cli_error "preflight-wireguard 不接受参数"; return 2; }; cmd_preflight_wireguard ;;
    wait-wireguard) [ "$#" -eq 0 ] || { cli_error "wait-wireguard 不接受参数"; return 2; }; cmd_wait_wireguard ;;
    install-systemd) [ "$#" -eq 0 ] || { cli_error "install-systemd 不接受参数"; return 2; }; install_systemd ;;
    uninstall) run_with_runtime_lock wait cmd_uninstall "$@" ;;
    -h|--help|help) [ "$#" -eq 0 ] || { cli_error "help 不接受参数"; return 2; }; usage ;;
    '')
      if interactive_terminal_available; then
        cmd_menu
      else
        cli_error "当前没有交互终端；请指定 status、test、restart、update、reinstall、switch、logs 或 uninstall"
        return 2
      fi
      ;;
    *) cli_error "未知命令：${cmd}" ;;
  esac
}

if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  main "$@"
fi
